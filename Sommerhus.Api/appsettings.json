{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "Default": "Data Source=sommerhus.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DefaultAdmin": {
    "UserName": "admin",
    "Email": "admin@sommerhus.local"
  },
  "Jwt": {
    "Issuer": "Sommerhus.Api",
    "Audience": "Sommerhus.Admin",
    "AccessTokenMinutes": 60
  },
  "Pricing": {
    "EnabledV1": true,
    "CleaningFee": 950,
    "GuestFee": {
      "BaseGuests": 2,
      "PerGuestPerNight": 50
    },
    "VatRate": 0.25
  }
}
