<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the web.config that `dotnet publish` writes. The SDK fills in processPath and
  arguments; what is set here is what the generated default lacks: stdout logging into .\logs,
  so a site that answers 502 can be diagnosed from the file system. deploy.ps1 never mirrors
  over the logs folder. Has no effect on `dotnet run`.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Sommerhus.Api.dll"
                  stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
