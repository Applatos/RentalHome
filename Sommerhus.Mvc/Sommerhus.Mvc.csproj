<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<!-- Opgradér til LTS -->
		<TargetFramework>net8.0</TargetFramework>

		<!-- C# 12 følger med .NET 8 -->
		<LangVersion>12.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Ret stavefejl: Mcv -> Mvc -->
		<RootNamespace>Sommerhus.Mvc</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Scaffolding -->
		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.7" />
		<ProjectReference Include="..\Sommerhus.Domain\Sommerhus.Domain.csproj" />
		<ProjectReference Include="..\Sommerhus.Core\Sommerhus.Core.csproj" />
	</ItemGroup>

</Project>
