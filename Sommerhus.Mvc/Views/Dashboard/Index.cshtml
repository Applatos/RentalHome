@model Sommerhus.Mvc.ViewModels.Public.Dashboard.UserDashboardVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@{
    ViewData["Title"] = L["Dashboard.Title"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@L["Dashboard.Welcome", Model.UserName]</h1>
    <span class="badge bg-secondary">@L.RoleLabel(Model.Role)</span>
</div>

<div class="row g-4">
    <!-- Upcoming Bookings -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">@L["Dashboard.UpcomingBookings"]</h2>
                <a href="/bookings" class="btn btn-outline-dark btn-sm">@L["Dashboard.ViewAll"]</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingBookings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@L["Bookings.House"]</th>
                                    <th>@L["Bookings.CheckIn"]</th>
                                    <th>@L["Bookings.CheckOut"]</th>
                                    <th>@L["Houses.Details.Guests"]</th>
                                    <th>@L["Bookings.Status"]</th>
                                    <th>@L["Bookings.Price"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.UpcomingBookings)
                                {
                                    <tr class="cursor-pointer" onclick="location.href='/bookings/@b.Id'">
                                        <td>@b.HouseTitle</td>
                                        <td>@b.CheckIn.ToString("d MMM yyyy")</td>
                                        <td>@b.CheckOut.ToString("d MMM yyyy")</td>
                                        <td>@b.Guests</td>
                                        <td>
                                            @{
                                                var statusClass = b.Status switch
                                                {
                                                    Sommerhus.Domain.Models.BookingStatus.Pending => "bg-warning text-dark",
                                                    Sommerhus.Domain.Models.BookingStatus.Confirmed => "bg-success",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @statusClass">@L.Label(b.Status)</span>
                                        </td>
                                        <td>@b.TotalPrice.ToString("N0") @b.Currency</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <p class="mb-2">@L["Dashboard.NoUpcoming"]</p>
                        <a href="/houses" class="btn btn-dark btn-sm">@L["Shared.BrowseHouses"]</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Profile Summary -->
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <h2 class="h5 mb-0">@L["Dashboard.QuickLinks"]</h2>
            </div>
            <div class="list-group list-group-flush">
                <a href="/bookings" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    @L["Bookings.Title"]
                    <span class="badge bg-dark rounded-pill">@(Model.UpcomingBookings.Count + Model.PastBookings.Count)</span>
                </a>
                <a href="/houses" class="list-group-item list-group-item-action">@L["Shared.BrowseHouses"]</a>
            </div>
        </div>
    </div>
</div>

<!-- Favorites -->
<div class="mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h2 class="h5 mb-0">@L["Dashboard.Favorites"]</h2>
        </div>
        <div class="card-body">
            @if (Model.Favorites.Any())
            {
                <div class="row g-3">
                    @foreach (var fav in Model.Favorites)
                    {
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <a href="/houses/@fav.HouseId" class="text-decoration-none text-dark">
                                <div class="card h-100 shadow-sm">
                                    @if (!string.IsNullOrWhiteSpace(fav.CoverUrl))
                                    {
                                        <img src="@fav.CoverUrl" class="card-img-top" alt="@fav.HouseTitle"
                                             style="height:140px;object-fit:cover;" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                             style="height:140px;">
                                            <span class="text-muted">@L["Dashboard.NoImage"]</span>
                                        </div>
                                    }
                                    <div class="card-body p-2">
                                        <h6 class="card-title mb-1 text-truncate">@fav.HouseTitle</h6>
                                        @if (!string.IsNullOrWhiteSpace(fav.City))
                                        {
                                            <small class="text-muted">@fav.City</small>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center mb-0">@L["Dashboard.NoFavorites"]</p>
            }
        </div>
    </div>
</div>

<!-- Booking History -->
@if (Model.PastBookings.Any())
{
    <div class="mt-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <h2 class="h5 mb-0">@L["Dashboard.BookingHistory"]</h2>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@L["Bookings.House"]</th>
                                <th>@L["Bookings.CheckIn"]</th>
                                <th>@L["Bookings.CheckOut"]</th>
                                <th>@L["Bookings.Status"]</th>
                                <th>@L["Bookings.Price"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.PastBookings)
                            {
                                <tr class="cursor-pointer" onclick="location.href='/bookings/@b.Id'">
                                    <td>@b.HouseTitle</td>
                                    <td>@b.CheckIn.ToString("d MMM yyyy")</td>
                                    <td>@b.CheckOut.ToString("d MMM yyyy")</td>
                                    <td>
                                        @{
                                            var histClass = b.Status switch
                                            {
                                                Sommerhus.Domain.Models.BookingStatus.Completed => "bg-info",
                                                Sommerhus.Domain.Models.BookingStatus.Cancelled => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @histClass">@L.Label(b.Status)</span>
                                    </td>
                                    <td>@b.TotalPrice.ToString("N0") @b.Currency</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    <style>
        .cursor-pointer { cursor: pointer; }
    </style>
}
