@{
    var q = (string?)ViewBag.Query ?? string.Empty;
}

<div class="admin-shell">
    <div class="master p-3">
        <div class="d-flex justify-content-between align-items-center mb-3 gap-2">
            <form class="flex-grow-1"
                  hx-get="/admin/areas/master"
                  hx-target="#areas-master"
                  hx-swap="outerHTML">
                <div class="input-group">
                    <input type="text" name="q" value="@q" class="form-control" placeholder="Søg område…" />
                    <button class="btn btn-outline-secondary" type="submit">Søg</button>
                </div>
            </form>
            <button class="btn btn-dark"
                    hx-get="/admin/areas/create"
                    hx-target="#areas-detail"
                    hx-swap="innerHTML">Nyt område</button>
        </div>

        <div id="areas-master"
             hx-get="@Url.Action("AreasMaster", "Admin", new { q = q })"
             hx-trigger="load, admin-areas-updated from:body">
            <div class="p-3 text-muted">Indlæser områder…</div>
        </div>
    </div>

    <div class="detail p-3" id="areas-detail">
        <div class="text-muted">Vælg et område i listen for at se detaljer…</div>
    </div>
</div>
