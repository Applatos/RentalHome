@{
    var q = (string?)ViewBag.Query ?? string.Empty;
}

<div class="admin-shell">
    <div class="master p-3">
        <div class="d-flex justify-content-between align-items-center mb-3 gap-2">
            <form class="flex-grow-1"
                  hx-get="/admin/features/master"
                  hx-target="#features-master"
                  hx-swap="outerHTML">
                <div class="input-group">
                    <input type="text" name="q" value="@q" class="form-control" placeholder="Søg feature…" />
                    <button class="btn btn-outline-secondary" type="submit">Søg</button>
                </div>
            </form>
            <button class="btn btn-dark"
                    hx-get="/admin/features/create"
                    hx-target="#features-detail"
                    hx-swap="innerHTML">Ny feature</button>
        </div>

        <div id="features-master"
             hx-get="@Url.Action("FeaturesMaster", "Admin", new { q = q })"
             hx-trigger="load, admin-features-updated from:body">
            <div class="p-3 text-muted">Indlæser features…</div>
        </div>
    </div>

    <div class="detail p-3" id="features-detail">
        <div class="text-muted">Vælg en feature i listen for at se detaljer…</div>
    </div>
</div>
