@using Sommerhus.Core.Dtos.Shared
@model IReadOnlyList<HouseGroupDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@{
    ViewData["Title"] = L["Admin.HouseGroups.Index.PageTitle"];
}

<section class="container my-3">
    @await Html.PartialAsync("~/Views/Admin/Shared/_FlashMessages.cshtml")
    @await Html.PartialAsync("~/Views/Admin/Shared/_AdminTabs.cshtml")


    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@L["Admin.HouseGroups.Index.Title"]</h2>
        <a asp-action="New" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @L["Admin.HouseGroups.Index.Create"]
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <h5 class="text-muted">@L["Admin.HouseGroups.Index.EmptyTitle"]</h5>
            <p class="text-muted">@L["Admin.HouseGroups.Index.EmptyHelp"]</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var group in Model)
            {
                string houseLabel = group.HouseCount == 1
                    ? (L["Admin.HouseGroups.Index.HouseSingular"].Value ?? string.Empty)
                    : (L["Admin.HouseGroups.Index.HousePlural"].Value ?? string.Empty);
                var houseCountFormat = L["Admin.HouseGroups.Index.HouseCount"].Value ?? "{0} {1}";
                var houseCountText = string.Format(houseCountFormat, group.HouseCount, houseLabel);

                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@group.Name</h5>
                            <p class="card-text">
                                <small class="text-muted">
                                    @houseCountText
                                </small>
                            </p>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@group.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-calendar3"></i> @L["Admin.HouseGroups.Index.Calendar"]
                                </a>
                                <a asp-action="Edit" asp-route-id="@group.Id" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-pencil"></i> @L["Admin.Shared.Edit"]
                                </a>
                                <form asp-action="Delete" asp-route-id="@group.Id" method="post" 
                                      onsubmit="return confirm('@L["Admin.HouseGroups.Index.DeleteConfirm"]');"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i> @L["Admin.Shared.Delete"]
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
