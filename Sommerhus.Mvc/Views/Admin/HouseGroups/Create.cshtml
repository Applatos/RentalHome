@using Sommerhus.Core.Dtos.Admin.Pricing
@model UpsertHouseGroupDto
@{
    ViewData["Title"] = "Admin - Opret husgruppe";
}

<section class="container my-3">
    @await Html.PartialAsync("_AdminTabs")

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Opret husgruppe</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Tilbage til oversigt
        </a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Gruppenavn *</label>
                            <input asp-for="Name" class="form-control" placeholder="fx. Vestkysten, Sommerland, etc." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <div class="form-text">Vælg et beskrivende navn til husgruppen (maks. 100 tegn).</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-lg"></i> Opret gruppe
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Annullér</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-body-secondary">
                    <strong>Om husgrupper</strong>
                </div>
                <div class="card-body">
                    <p class="text-muted">Husgrupper bruges til at organisere huse og dele sæsonkalendere mellem dem.</p>
                    <ul class="text-muted small">
                        <li>Opret en gruppe for huse med lignende beliggenhed</li>
                        <li>Del en fælles sæsonkalender mellem alle huse i gruppen</li>
                        <li>Gør det nemmere at administrere priser for flere huse</li>
                        <li>Grupper kan tildeles og fjernes fra huse når som helst</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
