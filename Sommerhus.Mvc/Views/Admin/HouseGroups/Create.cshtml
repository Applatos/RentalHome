@using Sommerhus.Core.Dtos.Shared
@model UpsertHouseGroupDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@{
    ViewData["Title"] = L["Admin.HouseGroups.Create.PageTitle"];
}

<section class="container my-3">

    @await Html.PartialAsync("~/Views/Admin/Shared/_AdminTabs.cshtml")

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@L["Admin.HouseGroups.Create.Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @L["Admin.Shared.BackToOverview"]
        </a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <form
                        asp-action="Create"
                        method="post">

                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">@L["Admin.HouseGroups.Form.Name"] *</label>
                            <input asp-for="Name" class="form-control" placeholder="@L["Admin.HouseGroups.Form.NamePlaceholder"]" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <div class="form-text">@L["Admin.HouseGroups.Form.NameHint"]</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-lg"></i> @L["Admin.HouseGroups.Create.Submit"]
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">@L["Admin.Shared.Cancel"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-body-secondary">
                    <strong>@L["Admin.HouseGroups.Shared.AboutTitle"]</strong>
                </div>
                <div class="card-body">
                    <p class="text-muted">@L["Admin.HouseGroups.Shared.AboutIntro"]</p>
                    <ul class="text-muted small">
                        <li>@L["Admin.HouseGroups.Shared.Bullet1"]</li>
                        <li>@L["Admin.HouseGroups.Shared.Bullet2"]</li>
                        <li>@L["Admin.HouseGroups.Shared.Bullet3"]</li>
                        <li>@L["Admin.HouseGroups.Shared.Bullet4"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
