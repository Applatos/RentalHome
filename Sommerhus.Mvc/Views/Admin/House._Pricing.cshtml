@using System.Globalization
@using System.Linq
@using Sommerhus.Contracts.Dtos.Admin.Pricing
@model Sommerhus.Contracts.Dtos.Admin.Houses.HouseDetailsDto

@{
    var plan = Model.Pricing;
    var seasonCodes = ViewBag.SeasonCodes as IReadOnlyList<SeasonCodeDto> ?? Array.Empty<SeasonCodeDto>();
    var planPrices = plan?.SeasonPrices ?? Array.Empty<SeasonPriceDto>();
    var calendar = Model.Calendar ?? Array.Empty<SeasonSpanDto>();
    var currency = string.IsNullOrWhiteSpace(plan?.Currency) ? "DKK" : plan.Currency.ToUpperInvariant();

    var priceLookup = new Dictionary<string, SeasonPriceDto>(StringComparer.OrdinalIgnoreCase);
    foreach (var price in planPrices)
    {
        if (!priceLookup.ContainsKey(price.Code))
        {
            priceLookup[price.Code] = price;
        }
    }

    var displayRows = new List<(string Code, string? Label, string? Color, SeasonPriceDto? Price)>();
    foreach (var code in seasonCodes.OrderBy(c => c.SortOrder).ThenBy(c => c.Code, StringComparer.OrdinalIgnoreCase))
    {
        priceLookup.TryGetValue(code.Code, out var existingPrice);
        displayRows.Add((code.Code, code.Label, code.Color, existingPrice));
    }

    var knownCodes = new HashSet<string>(displayRows.Select(r => r.Code));
    foreach (var price in planPrices.OrderBy(p => p.Code, StringComparer.OrdinalIgnoreCase))
    {
        if (knownCodes.Add(price.Code))
        {
            displayRows.Add((price.Code, price.Code, null, price));
        }
    }

    var labelLookup = seasonCodes.ToDictionary(
        c => c.Code,
        c => (Label: c.Label, Color: c.Color),
        StringComparer.OrdinalIgnoreCase);

    var seasonError = ViewBag.SeasonCodesError as string;
}

@if (!string.IsNullOrWhiteSpace(seasonError))
{
    <div class="alert alert-warning">
        @seasonError
    </div>
}

<form method="post" asp-controller="Admin" asp-action="SaveHousePricing" asp-route-id="@Model.Id" class="mt-3" id="house-pricing-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="PlanId" value="@(plan?.planId.ToString() ?? string.Empty)" />

    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Prisplan</label>
            <input class="form-control" name="Name" value="@(string.IsNullOrWhiteSpace(plan?.Name) ? "Standard" : plan.Name)" placeholder="Standard" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Valuta</label>
            <select class="form-select" name="Currency">
                <option value="DKK" selected="@(currency == "DKK")">DKK</option>
                <option value="EUR" selected="@(currency == "EUR")">EUR</option>
                <option value="SEK" selected="@(currency == "SEK")">SEK</option>
                <option value="NOK" selected="@(currency == "NOK")">NOK</option>
                <option value="GBP" selected="@(currency == "GBP")">GBP</option>
                <option value="USD" selected="@(currency == "USD")">USD</option>
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(plan is null || plan.IsActive ? "checked" : null) id="plan-active" />
                <label class="form-check-label" for="plan-active">Aktiv</label>
            </div>
        </div>
        <div class="col-md-4 text-md-end">
            @if (plan is not null)
            {
                <small class="text-muted d-block">Sidst opdateret @(plan.UpdatedUtc?.ToLocalTime().ToString("g") ?? plan.CreatedUtc.ToLocalTime().ToString("g"))</small>
            }
        </div>
    </div>

    <div class="table-responsive mt-3">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th class="w-25">Sæsonkode</th>
                    <th class="w-50">Beskrivelse</th>
                    <th class="w-25 text-end">Pris pr. nat (@currency)</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < displayRows.Count; i++)
                {
                    var row = displayRows[i];
                    var price = row.Price?.NightlyPrice;
                    var idValue = row.Price?.Id.ToString() ?? string.Empty;
                    var ratePlanId = row.Price?.RatePlanId.ToString() ?? (plan?.planId.ToString() ?? string.Empty);
                    <tr>
                        <td>
                            <input type="hidden" name="SeasonPrices[@i].Code" value="@row.Code" />
                            <input type="hidden" name="SeasonPrices[@i].Id" value="@idValue" />
                            <input type="hidden" name="SeasonPrices[@i].RatePlanId" value="@ratePlanId" />
                            <span class="badge rounded-pill" style="background-color:@(string.IsNullOrWhiteSpace(row.Color) ? "#6c757d" : row.Color)">
                                @row.Code
                            </span>
                        </td>
                        <td>
                            @(string.IsNullOrWhiteSpace(row.Label) ? "Ingen beskrivelse" : row.Label)
                        </td>
                        <td class="text-end">
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control text-end"
                                   name="SeasonPrices[@i].NightlyPrice"
                                   value="@(price.HasValue? price.Value.ToString("0.##", CultureInfo.InvariantCulture) : string.Empty)"
                                   placeholder="0,00" />
                        </td>
                    </tr>
                }
                @if (displayRows.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-muted text-center py-3">
                            Ingen sæsonkoder tilgængelige. Tilføj koder via pris-API'et.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="form-text">Efterlad feltet tomt for at fjerne prisen for en kode.</p>

    <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-primary">Gem priser</button>
    </div>
</form>

<hr class="my-4" />

<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5>Sæsonkalender</h5>
        @if (Model.GroupId.HasValue)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addHouseSeasonSpanModal">
                <i class="bi bi-plus-lg"></i> Tilføj sæsonperiode
            </button>
        }
        else
        {
            <small class="text-muted">Tildel huset til en gruppe for at administrere sæsonkalender</small>
        }
    </div>

    @if (calendar.Count == 0)
    {
        <p class="text-muted mb-0">
            @if (Model.GroupId.HasValue)
            {
                <text>Ingen sæsonintervaller er defineret for dette hus' gruppe.</text>
            }
            else
            {
                <text>Dette hus er ikke tildelt en gruppe, så der er ingen fælles sæsonkalender.</text>
            }
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Kode</th>
                        <th>Beskrivelse</th>
                        <th>Startdato</th>
                        <th>Slutdato</th>
                        @if (Model.GroupId.HasValue)
                        {
                            <th class="text-end">Handlinger</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var span in calendar)
                    {
                        labelLookup.TryGetValue(span.Code, out var meta);
                        var label = meta.Label ?? span.Code;
                        var color = meta.Color;
                        <tr>
                            <td>
                                <span class="badge rounded-pill" style="background-color:@(string.IsNullOrWhiteSpace(color) ? "#6c757d" : color)">
                                    @span.Code
                                </span>
                            </td>
                            <td>@label</td>
                            <td>@span.StartDate.ToString("d", CultureInfo.CurrentCulture)</td>
                            <td>@span.EndDate.ToString("d", CultureInfo.CurrentCulture)</td>
                            @if (Model.GroupId.HasValue)
                            {
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary" 
                                                data-bs-toggle="modal" data-bs-target="#editHouseSeasonSpanModal"
                                                data-span-id="@span.Id"
                                                data-start-date="@span.StartDate.ToString("yyyy-MM-dd")"
                                                data-end-date="@span.EndDate.ToString("yyyy-MM-dd")"
                                                data-code="@span.Code">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form asp-controller="Admin" asp-action="DeleteHouseSeasonSpan" asp-route-houseId="@Model.Id" asp-route-spanId="@span.Id" 
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Er du sikker på at du vil slette denne sæsonperiode?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<!-- Add House Season Span Modal -->
@if (Model.GroupId.HasValue)
{
    <div class="modal fade" id="addHouseSeasonSpanModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Tilføj sæsonperiode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-controller="Admin" asp-action="AddHouseSeasonSpan" asp-route-houseId="@Model.Id">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="mb-3">
                            <label for="HouseCode" class="form-label">Sæsonkode *</label>
                            <select name="Code" id="HouseCode" class="form-select" required>
                                <option value="">Vælg sæsonkode</option>
                                @foreach (var code in seasonCodes.OrderBy(c => c.SortOrder).ThenBy(c => c.Code))
                                {
                                    <option value="@code.Code">@code.Code - @(code.Label ?? code.Code)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="HouseStartDate" class="form-label">Startdato *</label>
                            <input type="date" name="StartDate" id="HouseStartDate" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="HouseEndDate" class="form-label">Slutdato *</label>
                            <input type="date" name="EndDate" id="HouseEndDate" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annullér</button>
                        <button type="submit" class="btn btn-primary">Tilføj periode</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit House Season Span Modal -->
    <div class="modal fade" id="editHouseSeasonSpanModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rediger sæsonperiode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" id="editHouseSeasonSpanForm">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <input type="hidden" id="editHouseSpanId" name="spanId" />
                        
                        <div class="mb-3">
                            <label for="editHouseCode" class="form-label">Sæsonkode *</label>
                            <select name="Code" id="editHouseCode" class="form-select" required>
                                <option value="">Vælg sæsonkode</option>
                                @foreach (var code in seasonCodes.OrderBy(c => c.SortOrder).ThenBy(c => c.Code))
                                {
                                    <option value="@code.Code">@code.Code - @(code.Label ?? code.Code)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="editHouseStartDate" class="form-label">Startdato *</label>
                            <input type="date" name="StartDate" id="editHouseStartDate" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="editHouseEndDate" class="form-label">Slutdato *</label>
                            <input type="date" name="EndDate" id="editHouseEndDate" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annullér</button>
                        <button type="submit" class="btn btn-primary">Gem ændringer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle edit house season span modal
            const editHouseSeasonSpanModal = document.getElementById('editHouseSeasonSpanModal');
            if (editHouseSeasonSpanModal) {
                editHouseSeasonSpanModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const spanId = button.getAttribute('data-span-id');
                    const startDate = button.getAttribute('data-start-date');
                    const endDate = button.getAttribute('data-end-date');
                    const code = button.getAttribute('data-code');

                    document.getElementById('editHouseSpanId').value = spanId;
                    document.getElementById('editHouseStartDate').value = startDate;
                    document.getElementById('editHouseEndDate').value = endDate;
                    document.getElementById('editHouseCode').value = code;

                    // Update form action
                    const form = document.getElementById('editHouseSeasonSpanForm');
                    form.action = `/admin/houses/@Model.Id/calendar/${spanId}`;
                });
            }
        });
    </script>
}