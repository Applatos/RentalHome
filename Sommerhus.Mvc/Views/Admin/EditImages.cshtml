@model Sommerhus.Mvc.Services.HouseDetails
@{
    ViewData["Title"] = "Billeder – " + Model.Title;
}
<link rel="stylesheet" href="/css/site-additions.css" />

<div class="container py-4">
    <h2>Billeder – @Model.Title</h2>

    <div class="row g-4">
        <div class="col-md-4">
            <h5>Cover</h5>
            @if (Model.CoverUrl is not null)
            {
                <img class="w-100 rounded mb-2" style="height:200px; object-fit:cover" src="@Model.CoverUrl" />
            }
            <form method="post" enctype="multipart/form-data" action="/admin/@Model.Id/images/cover">
                <input type="file" name="file" class="form-control mb-2" accept="image/*" />
                <button class="btn btn-dark">Upload</button>
            </form>
        </div>

        <div class="col-md-4">
            <h5>Plantegning</h5>
            @if (Model.Floorplan is not null)
            {
                <img class="w-100 rounded bg-white mb-2" style="height:200px; object-fit:contain" src="@Model.Floorplan.Url" />
            }
            <form method="post" enctype="multipart/form-data" action="/admin/@Model.Id/images/floorplan">
                <input type="file" name="file" class="form-control mb-2" accept="image/*" />
                <button class="btn btn-dark">Upload</button>
            </form>
        </div>

        <div class="col-md-4">
            <h5>Galleri</h5>
            <form method="post" enctype="multipart/form-data" action="/admin/@Model.Id/images/gallery">
                <input type="file" name="files" multiple class="form-control mb-2" accept="image/*" />
                <button class="btn btn-dark">Upload</button>
            </form>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row g-3">
        @foreach (var g in Model.Gallery)
        {
            <div class="col-6 col-md-3">
                <div class="card shadow-sm">
                    <img class="card-img-top" style="height:160px; object-fit:cover" src="@g.Url" />
                    <div class="card-body p-2 d-flex gap-2">
                        <form method="post" action="/admin/@Model.Id/images/@g.Id/cover">
                            <button class="btn btn-sm btn-outline-dark">Gør til cover</button>
                        </form>
                        <form method="post" action="/admin/@Model.Id/images/@g.Id/delete">
                            <button class="btn btn-sm btn-outline-danger">Slet</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
