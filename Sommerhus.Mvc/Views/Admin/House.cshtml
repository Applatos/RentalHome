@using Sommerhus.Contracts.Dtos.Admin.Houses
@model Sommerhus.Contracts.Dtos.Admin.Houses.HouseDetailsDto
@{
    ViewData["Title"] = Model.Name;
    var tab = (string)(ViewBag.Tab ?? "overview");
}

<section class="container my-3">
@*     @await Html.PartialAsync("_AdminTabs") *@

    @if (TempData["Ok"] is string ok) { <div class="alert alert-success">@ok</div> }
    @if (TempData["Err"] is string err){ <div class="alert alert-danger">@err</div> }

    <div class="d-flex justify-content-between">
        <h2 class="mb-2">@Model.Name</h2>
        <small class="text-muted">Oprettet @Model.CreatedUtc.ToLocalTime()</small>
    </div>

    <ul class="nav nav-tabs mt-2">
        <li class="nav-item">
            <a class="nav-link @(tab == "overview" ? "active" : "")"
               href="@Url.Action("House", "Admin", new { id = Model.Id, tab = "overview" })">Oversigt</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(tab == "images" ? "active" : "")"
               href="@Url.Action("House", "Admin", new { id = Model.Id, tab = "images" })">Billeder</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(tab == "features" ? "active" : "")"
               href="@Url.Action("House", "Admin", new { id = Model.Id, tab = "features" })">Features</a>
        </li>
    </ul>

    <div class="border-start border-end border-bottom p-3 rounded-bottom">
        @if (tab == "overview")
        {
            @await Html.PartialAsync("House._Overview", Model)
        }
        else if (tab == "images")
        {
            @await Html.PartialAsync("House._Images", Model)
        }
        else if (tab == "features")
        {
            @await Html.PartialAsync("House._Features", Model)
        }
    </div>
</section>
