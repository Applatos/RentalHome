@model Sommerhus.Mvc.Controllers.AdminController.MasterListVm

<div class="list-group list-group-flush mb-3">
    @foreach (var h in Model.Items)
    {
        <a href="#"
           class="list-group-item list-group-item-action d-flex align-items-center"
           hx-get="/admin/@h.Id/detail" hx-target="#detail" hx-swap="innerHTML">
            <img src="@(string.IsNullOrWhiteSpace(h.Cover) ? "/images/placeholder.jpg" : h.Cover)" class="me-2 img-thumb" alt="cover" />
            <div>
                <div class="fw-semibold">@h.Title</div>
                <div class="text-muted small">@h.City @h.Zip</div>
            </div>
        </a>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination mb-0">
            @{
                var prevDisabled = Model.Page <= 1 ? " disabled" : "";
                var nextDisabled = Model.Page >= Model.TotalPages ? " disabled" : "";
            }
            <li class="page-item@prevDisabled">
                <a class="page-link"
                   hx-get='@Url.Action("Master", "Admin", new { q = Model.Query, page = Model.Page - 1, pageSize = Model.PageSize })'
                   hx-target="#master" hx-swap="outerHTML">«</a>
            </li>

            @{
                var start = Math.Max(1, Model.Page - 2);
                var end = Math.Min(Model.TotalPages, start + 4);
                for (var i = start; i <= end; i++)
                {
                    var active = i == Model.Page ? " active" : "";
                    <li class="page-item@active">
                        <a class="page-link"
                           hx-get='@Url.Action("Master", "Admin", new { q = Model.Query, page = i, pageSize = Model.PageSize })'
                           hx-target="#master" hx-swap="outerHTML">@i</a>
                    </li>
                }
            }

            <li class="page-item@nextDisabled">
                <a class="page-link"
                   hx-get='@Url.Action("Master", "Admin", new { q = Model.Query, page = Model.Page + 1, pageSize = Model.PageSize })'
                   hx-target="#master" hx-swap="outerHTML">»</a>
            </li>
        </ul>
    </nav>
}
