@model Sommerhus.Mvc.Services.HouseDetails
@{
    ViewData["Title"] = "Billeder";
}
<div class="container py-4">
    <h3>Billeder – @Model.Title</h3>

    <div class="row g-3">
        <div class="col-md-4">
            <h5>Cover</h5>
            <div class="ratio ratio-16x9 rounded bg-light mb-2">
                @if (!string.IsNullOrWhiteSpace(Model.CoverUrl))
                {
                    <img class="w-100 h-100" style="object-fit:cover" src="@Model.CoverUrl" />
                }
            </div>
            <form method="post" enctype="multipart/form-data" action="/admin/@Model.Id/images/cover">
                <input type="file" name="file" class="form-control mb-2" accept="image/*" />
                <button class="btn btn-dark">Upload cover</button>
            </form>
        </div>

        <div class="col-md-4">
            <h5>Plantegning</h5>
            @if (Model.Floorplan is not null)
            {
                <img class="w-100 rounded bg-white mb-2" style="height:220px; object-fit:contain" src="@Model.Floorplan.Url" />
            }
            <form method="post" enctype="multipart/form-data" action="/admin/@Model.Id/images/floorplan">
                <input type="file" name="file" class="form-control mb-2" accept="image/*" />
                <button class="btn btn-dark">Upload plantegning</button>
            </form>
        </div>

        <div class="col-md-4">
            <h5>Galleri</h5>
            <form method="post" enctype="multipart/form-data" action="/admin/@Model.Id/images/gallery">
                <input type="file" name="files" class="form-control mb-2" accept="image/*" multiple />
                <button class="btn btn-dark">Upload billeder</button>
            </form>

            @if (Model.Gallery.Length > 0)
            {
                <div class="d-flex flex-wrap gap-2 mt-2">
                    @foreach (var g in Model.Gallery)
                    {
                        <div class="card p-1" style="width:110px;">
                            <img src="@g.Url" class="rounded mb-1" style="height:70px;object-fit:cover" />
                            <div class="d-flex gap-1">
                                <form method="post" action="/admin/@Model.Id/images/@g.Id/setcover">
                                    <button class="btn btn-sm btn-outline-primary">Cover</button>
                                </form>
                                <form method="post" action="/admin/@Model.Id/images/@g.Id/delete">
                                    <button class="btn btn-sm btn-outline-danger">Slet</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a class="btn btn-outline-secondary" href="/admin">Tilbage</a>
        <a class="btn btn-outline-primary" href="/houses/@Model.Id" target="_blank">Se hus</a>
    </div>
</div>
