@model Sommerhus.Mvc.Controllers.AdminController.FeatureDetailVm?
@{
    var success = ViewData["Success"] as string ?? ViewBag.Success as string;
}

@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success" role="alert">@success</div>
}

@if (Model is null)
{
    @Html.AntiForgeryToken()
    <div class="text-muted">Vælg en feature for at se detaljer…</div>
}
else
{
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">@Model.Name</h5>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-primary"
                    hx-get="/admin/features/@Model.Id/edit"
                    hx-target="#features-detail"
                    hx-swap="innerHTML">Redigér</button>
            <form hx-post="/admin/features/@Model.Id/delete"
                  hx-target="#features-detail"
                  hx-swap="innerHTML"
                  hx-confirm="Slet denne feature?"
                  class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-danger" type="submit">Slet</button>
            </form>
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Nøgle</dt>
        <dd class="col-sm-9">@Model.Key</dd>
        <dt class="col-sm-3">Datatype</dt>
        <dd class="col-sm-9">@Model.ValueType</dd>
        <dt class="col-sm-3">Enhed</dt>
        <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Unit) ? Model.Unit : "-")</dd>
        <dt class="col-sm-3">Sortering</dt>
        <dd class="col-sm-9">@Model.SortOrder</dd>
        <dt class="col-sm-3">Ikon</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrWhiteSpace(Model.IconUrl))
            {
                <img src="@Model.IconUrl" alt="ikon" style="max-height:48px;max-width:48px;object-fit:contain" />
            }
            else
            {
                <span class="text-muted">Ingen</span>
            }
        </dd>
    </dl>

    <div class="mt-3">
        <form hx-post="/admin/features/@Model.Id/icon"
              hx-target="#features-detail"
              hx-swap="innerHTML"
              hx-encoding="multipart/form-data"
              enctype="multipart/form-data"
              class="d-flex gap-2 align-items-center mb-2">
            @Html.AntiForgeryToken()
            <input type="file" name="file" accept="image/*" class="form-control form-control-sm" />
            <button class="btn btn-sm btn-outline-secondary" type="submit">Upload ikon</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.IconUrl))
        {
            <form hx-post="/admin/features/@Model.Id/icon/delete"
                  hx-target="#features-detail"
                  hx-swap="innerHTML"
                  hx-confirm="Fjern ikon?"
                  class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-danger" type="submit">Fjern ikon</button>
            </form>
        }
    </div>
}
