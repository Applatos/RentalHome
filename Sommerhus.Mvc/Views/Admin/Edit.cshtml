@model Sommerhus.Mvc.Controllers.AdminController.CreateFormVM
@{
    ViewData["Title"] = "Redigér hus";
    var id = (Guid)ViewBag.HouseId;
}
<div class="container py-4">
    <h3>Redigér hus</h3>
    <form method="post" action="/admin/@id/edit">
        @Html.AntiForgeryToken()

        <partial name="_HouseFormFields" model="Model" />

        <div class="mt-3">
            <button class="btn btn-dark">Gem</button>
            <a class="btn btn-outline-secondary" href="/admin">Tilbage</a>
        </div>
    </form>
</div>
