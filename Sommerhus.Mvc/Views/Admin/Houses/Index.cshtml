@using Sommerhus.Mvc.ViewModels.Admin.Houses
@using Sommerhus.Domain.Models
@model HouseListVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@{
    ViewData["Title"] = L["Admin.Houses.Index.PageTitle"];
    var totalPages = (int)Math.Ceiling((double)Model.Houses.Total / Math.Max(1, Model.Houses.PageSize));
}
<section class="container my-3">
    @await Html.PartialAsync("~/Views/Admin/Shared/_AdminTabs.cshtml")
    @await Html.PartialAsync("~/Views/Admin/Shared/_FlashMessages.cshtml")

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">@L["Admin.Houses.Index.Title"]</h2>
        <a class="btn btn-primary" asp-controller="Houses" asp-action="New">+ @L["Admin.Houses.Index.Create"]</a>
    </div>

    <form method="get" class="row gy-2 gx-2 mb-3" asp-controller="Houses" asp-action="Index">
        <div class="col-md-4">
            <input class="form-control" name="q" value="@Model.SearchQuery" placeholder="@L["Shared.SearchPlaceholder"]" />
        </div>
        <div class="col-md-2">
            <select class="form-select" name="status">
                <option value="">@L["Admin.Houses.Index.AllStatuses"]</option>
                @foreach (var s in Enum.GetValues<EntityStatus>())
                {
                    <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" name="pageSize">
                @foreach (var size in new[] { 10, 20, 30, 50 })
                {
                    <option value="@size" selected="@(size == Model.Houses.PageSize)">@L["Admin.Houses.Index.PerPage", size]</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-dark w-100">@L["Shared.Search"]</button>
        </div>
    </form>

    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>@L["Admin.Houses.Form.Title"]</th>
                <th>@L["Admin.Houses.Form.City"]</th>
                <th>@L["Admin.Houses.Form.Areas"]</th>
                <th>@L["Admin.Shared.Status"]</th>
                <th>@L["Admin.Shared.Created"]</th>
                <th class="text-end">@L["Admin.Shared.Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model.Houses.Items)
            {
                <tr>
                    <td>@h.Title</td>
                    <td>@h.CityLabel</td>
                    <td>
                        @if (h.AreaLabels.Any())
                        {
                            <span>@string.Join(", ", h.AreaLabels)</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @{
                            var badgeClass = h.Status switch
                            {
                                EntityStatus.Published => "bg-success",
                                EntityStatus.Archived => "bg-secondary",
                                _ => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @badgeClass">@h.Status</span>
                    </td>
                    <td>@h.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                    <td class="text-end">
                        <a class="btn btn-outline-dark btn-sm" asp-action="Details" asp-controller="Houses" asp-route-id="@h.Id">@L["Admin.Shared.Details"]</a>
                        <form method="post" asp-action="Delete" asp-controller="Houses" asp-route-id="@h.Id" class="d-inline" onsubmit='return confirm("@string.Format(L["Admin.Houses.Index.DeleteConfirm"], h.Title)");'>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">@L["Admin.Shared.Delete"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @await Html.PartialAsync("~/Views/Admin/Shared/_Pagination.cshtml", (Model.Houses.Page, totalPages, Model.Houses.PageSize, Model.SearchQuery, "Index", "Houses"))
</section>
