@using Sommerhus.Mvc.ViewModels.Admin.Houses
@using Sommerhus.Domain.Models
@model HouseDetailsVm

<div class="d-flex align-items-center gap-2 mb-3">
    <span class="fw-semibold">Status:</span>
    @{
        var statusBadge = Model.House.Status switch
        {
            EntityStatus.Published => "bg-success",
            EntityStatus.Archived => "bg-secondary",
            _ => "bg-warning text-dark"
        };
    }
    <span class="badge @statusBadge fs-6">@Model.House.Status</span>

    @if (Model.House.Status == EntityStatus.Draft)
    {
        <form method="post" asp-controller="Houses" asp-action="ChangeStatus" asp-route-id="@Model.House.Id" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="target" value="@EntityStatus.Published" />
            <button type="submit" class="btn btn-success btn-sm">Publish</button>
        </form>
    }
    else if (Model.House.Status == EntityStatus.Published)
    {
        <form method="post" asp-controller="Houses" asp-action="ChangeStatus" asp-route-id="@Model.House.Id" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="target" value="@EntityStatus.Archived" />
            <button type="submit" class="btn btn-secondary btn-sm">Archive</button>
        </form>
        <form method="post" asp-controller="Houses" asp-action="ChangeStatus" asp-route-id="@Model.House.Id" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="target" value="@EntityStatus.Draft" />
            <button type="submit" class="btn btn-outline-warning btn-sm">Unpublish</button>
        </form>
    }
    else if (Model.House.Status == EntityStatus.Archived)
    {
        <form method="post" asp-controller="Houses" asp-action="ChangeStatus" asp-route-id="@Model.House.Id" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="target" value="@EntityStatus.Draft" />
            <button type="submit" class="btn btn-outline-warning btn-sm">Re-open as Draft</button>
        </form>
    }
</div>

<form method="post" asp-controller="Houses" asp-action="Update" asp-route-id="@Model.House.Id" class="row g-3">
    @Html.AntiForgeryToken()

    <div class="col-md-8">
        <label class="form-label">Title</label>
        <input class="form-control" name="Title" value="@Model.House.Title" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Address</label>
        <input class="form-control" name="Address" value="@Model.House.Address" />
    </div>

    <div class="col-md-6">
        <label class="form-label">City</label>
        <select class="form-select" name="CityId" asp-items="Model.Cities"></select>
    </div>

    <div class="col-md-6">
        <label class="form-label">Areas</label>
        <select class="form-select" name="AreaIds" asp-items="Model.Areas" multiple></select>
        <div class="form-text">Hold Ctrl/Cmd to select multiple (empty = none).</div>
    </div>

    <div class="col-md-6">
        <label class="form-label">House Group</label>
        <select class="form-select" name="GroupId" asp-items="Model.HouseGroups">
            <option value="">No group</option>
        </select>
        <div class="form-text">Select a group to share season calendar.</div>
    </div>

    <div class="col-md-12">
        <label class="form-label">Description</label>
        <textarea class="form-control" name="Description" rows="4">@Model.House.Description</textarea>
    </div>

    <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-controller="Houses" asp-action="Index">Back to List</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
