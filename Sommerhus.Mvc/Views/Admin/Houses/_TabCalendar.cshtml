@using System.Globalization
@using Sommerhus.Core.Dtos.Shared
@using Sommerhus.Mvc.ViewModels.Admin.Houses
@model HouseDetailsVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L

@{
    // This tab edits the house's effective calendar: its own when it has one, otherwise its
    // group's, which every house in the group shares.
    var houseId = Model.House.Id;
    var seasonCodes = Model.SeasonCodes.OrderBy(c => c.SortOrder).ThenBy(c => c.Code, StringComparer.OrdinalIgnoreCase).ToList();
    var calendar = (Model.House.Calendar ?? Array.Empty<SeasonSpanDto>()).OrderBy(s => s.StartDate).ToList();
    var hasOverride = Model.SavedCalendarOverrideId.HasValue;
    var hasCalendar = hasOverride || !string.IsNullOrEmpty(Model.House.CalendarSource);
    var groupId = Model.SavedGroupId;
    var sharedWithGroup = hasCalendar && !hasOverride && groupId.HasValue;
    var groupName = Model.GroupName ?? string.Empty;
    var culture = CultureInfo.CurrentCulture;
    const string noColor = "#6c757d";

    var codeLookup = new Dictionary<string, SeasonCodeDto>(StringComparer.OrdinalIgnoreCase);
    foreach (var code in seasonCodes)
    {
        codeLookup.TryAdd(code.Code, code);
    }

    string SeasonLabel(SeasonSpanDto span)
        => span.SeasonName ?? (codeLookup.TryGetValue(span.Code, out var code) ? code.Label : null) ?? span.Code;

    string SeasonColor(string code)
        => codeLookup.TryGetValue(code, out var meta) && !string.IsNullOrWhiteSpace(meta.Color) ? meta.Color : noColor;

    string CodeOption(SeasonCodeDto code) => $"{code.Code} - {code.Label ?? code.Code}";
}

<section>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0">@L["Pages.AdminHouse.Calendar.Title"]</h5>
        @if (hasCalendar)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addHouseSeasonSpanModal">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Pages.AdminHouse.Calendar.AddSpan"]
            </button>
        }
    </div>

    <!-- Calendar source -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <span class="text-body-secondary small">@L["Pages.AdminHouse.Calendar.Source"]</span>
                    @if (hasOverride)
                    {
                        <span class="badge bg-info text-dark ms-1">@L["Pages.AdminHouse.Calendar.SourceOverride"]</span>
                        <p class="small mb-0 mt-1">@L["Pages.AdminHouse.Calendar.OwnCalendar"]</p>
                    }
                    else if (sharedWithGroup)
                    {
                        <span class="badge bg-secondary ms-1">@L["Pages.AdminHouse.Calendar.SourceGroup", groupName]</span>
                        <p class="small mb-0 mt-1">
                            @L["Pages.AdminHouse.Calendar.SharedWithGroup", groupName]
                            <a href="/admin/house-groups/@groupId">@L["Pages.AdminHouse.Calendar.OpenGroup"]</a>
                        </p>
                    }
                    else
                    {
                        <span class="text-body-secondary ms-1">@L["Pages.AdminHouse.Calendar.SourceNone"]</span>
                    }
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @if (hasOverride)
                    {
                        <form method="post" action="/admin/houses/@houseId/calendar-override/remove" class="d-inline"
                              data-confirm="@L["Pages.AdminHouse.Calendar.RevertConfirm"]">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-warning btn-sm">
                                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> @L["Pages.AdminHouse.Calendar.RevertToGroup"]
                            </button>
                        </form>
                    }
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#calendarOverrideModal">
                        <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                        @(hasOverride ? L["Pages.AdminHouse.Calendar.ChangeOverride"] : L["Pages.AdminHouse.Calendar.SetOverride"])
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (hasCalendar && calendar.Count == 0)
    {
        <p class="text-body-secondary mb-0">@L["Pages.AdminHouse.Calendar.NoSpans"]</p>
    }
    else if (calendar.Count > 0)
    {
        var firstMonth = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);

        <div class="mb-4">
            <h6 class="text-body-secondary mb-2">@L["Pages.AdminHouse.Calendar.NextMonths"]</h6>
            <div class="d-flex flex-wrap gap-1">
                @for (var m = 0; m < HousePricingCheck.CoverageMonths; m++)
                {
                    var monthStart = firstMonth.AddMonths(m);
                    var monthEnd = monthStart.AddMonths(1).AddDays(-1);
                    var span = calendar.FirstOrDefault(s => s.StartDate <= monthEnd && s.EndDate >= monthStart);
                    var monthLabel = monthStart.ToString("MMM yy", culture);
                    if (span is not null)
                    {
                        <div class="text-center p-2 rounded" style="background-color: @SeasonColor(span.Code); min-width: 64px; color: white; text-shadow: 0 0 2px rgba(0,0,0,0.5);" title="@SeasonLabel(span)">
                            <small class="d-block fw-bold">@monthLabel</small>
                            <small>@span.Code</small>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-2 rounded border bg-body-tertiary text-body-secondary" style="min-width: 64px;" title="@L["Pages.AdminHouse.Calendar.NoSeason"]">
                            <small class="d-block fw-bold">@monthLabel</small>
                            <small aria-label="@L["Pages.AdminHouse.Calendar.NoSeason"]">–</small>
                        </div>
                    }
                }
            </div>
            <div class="mt-2 d-flex flex-wrap gap-2">
                @foreach (var code in seasonCodes)
                {
                    <small class="d-flex align-items-center gap-1">
                        <span class="rounded" style="width: 12px; height: 12px; display: inline-block; background-color: @SeasonColor(code.Code);"></span>
                        @CodeOption(code)
                    </small>
                }
            </div>
        </div>

        <h6 class="text-body-secondary mb-2">@L["Pages.AdminHouse.Calendar.Spans"]</h6>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>@L["Pages.AdminHouse.Calendar.Code"]</th>
                        <th>@L["Pages.AdminHouse.Calendar.Season"]</th>
                        <th>@L["Pages.AdminHouse.Calendar.StartDate"]</th>
                        <th>@L["Pages.AdminHouse.Calendar.EndDate"]</th>
                        <th class="text-end">@L["Admin.Shared.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var span in calendar)
                    {
                        <tr>
                            <td>
                                <span class="badge rounded-pill" style="background-color:@SeasonColor(span.Code)">@span.Code</span>
                            </td>
                            <td>@SeasonLabel(span)</td>
                            <td>@span.StartDate.ToString("d", culture)</td>
                            <td>@span.EndDate.ToString("d", culture)</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary"
                                            data-bs-toggle="modal" data-bs-target="#editSpan-@span.Id"
                                            title="@L["Admin.Shared.Edit"]" aria-label="@L["Admin.Shared.Edit"]">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </button>
                                    <form action="/admin/houses/@houseId/calendar/@span.Id/delete"
                                          method="post" class="d-inline"
                                          data-confirm="@L["Pages.AdminHouse.Calendar.DeleteConfirm"]">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger"
                                                title="@L["Admin.Shared.Delete"]" aria-label="@L["Admin.Shared.Delete"]">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="form-text">@L["Pages.AdminHouse.Calendar.InclusiveHint"]</p>
    }
</section>

@if (hasCalendar)
{
    <div class="modal fade" id="addHouseSeasonSpanModal" tabindex="-1" aria-labelledby="addHouseSeasonSpanTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addHouseSeasonSpanTitle">@L["Pages.AdminHouse.Calendar.AddSpan"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Pages.AdminHouse.Calendar.Close"]"></button>
                </div>
                <form method="post" action="/admin/houses/@houseId/calendar">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        @if (sharedWithGroup)
                        {
                            <p class="small text-body-secondary">@L["Pages.AdminHouse.Calendar.SharedWithGroup", groupName]</p>
                        }

                        <div class="mb-3">
                            <label for="HouseCode" class="form-label">@L["Pages.AdminHouse.Calendar.SeasonCode"] *</label>
                            <select name="Code" id="HouseCode" class="form-select" required>
                                <option value="">@L["Pages.AdminHouse.Calendar.SelectCode"]</option>
                                @foreach (var code in seasonCodes)
                                {
                                    <option value="@code.Code">@CodeOption(code)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="HouseStartDate" class="form-label">@L["Pages.AdminHouse.Calendar.StartDate"] *</label>
                            <input type="date" name="StartDate" id="HouseStartDate" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="HouseEndDate" class="form-label">@L["Pages.AdminHouse.Calendar.EndDate"] *</label>
                            <input type="date" name="EndDate" id="HouseEndDate" class="form-control" required aria-describedby="HouseEndDateHint" />
                            <div id="HouseEndDateHint" class="form-text">@L["Pages.AdminHouse.Calendar.InclusiveHint"]</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Admin.Shared.Cancel"]</button>
                        <button type="submit" class="btn btn-primary">@L["Pages.AdminHouse.Calendar.AddSubmit"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* One edit form per span, each posting to its own span, so editing needs no script. *@
    @foreach (var span in calendar)
    {
        var knownCode = codeLookup.ContainsKey(span.Code);
        <div class="modal fade" id="editSpan-@span.Id" tabindex="-1" aria-labelledby="editSpanTitle-@span.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editSpanTitle-@span.Id">@L["Pages.AdminHouse.Calendar.EditSpan"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Pages.AdminHouse.Calendar.Close"]"></button>
                    </div>
                    <form method="post" action="/admin/houses/@houseId/calendar/@span.Id">
                        <div class="modal-body">
                            @Html.AntiForgeryToken()
                            @if (sharedWithGroup)
                            {
                                <p class="small text-body-secondary">@L["Pages.AdminHouse.Calendar.SharedWithGroup", groupName]</p>
                            }

                            <div class="mb-3">
                                <label for="editCode-@span.Id" class="form-label">@L["Pages.AdminHouse.Calendar.SeasonCode"] *</label>
                                <select name="Code" id="editCode-@span.Id" class="form-select" required>
                                    <option value="">@L["Pages.AdminHouse.Calendar.SelectCode"]</option>
                                    @if (!knownCode)
                                    {
                                        <option value="@span.Code" selected>@span.Code</option>
                                    }
                                    @foreach (var code in seasonCodes)
                                    {
                                        <option value="@code.Code" selected="@(string.Equals(code.Code, span.Code, StringComparison.OrdinalIgnoreCase))">@CodeOption(code)</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="editStart-@span.Id" class="form-label">@L["Pages.AdminHouse.Calendar.StartDate"] *</label>
                                <input type="date" name="StartDate" id="editStart-@span.Id" class="form-control" required
                                       value="@span.StartDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                            </div>

                            <div class="mb-3">
                                <label for="editEnd-@span.Id" class="form-label">@L["Pages.AdminHouse.Calendar.EndDate"] *</label>
                                <input type="date" name="EndDate" id="editEnd-@span.Id" class="form-control" required
                                       value="@span.EndDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Admin.Shared.Cancel"]</button>
                            <button type="submit" class="btn btn-primary">@L["Admin.Shared.SaveChanges"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

<!-- Calendar override -->
<div class="modal fade" id="calendarOverrideModal" tabindex="-1" aria-labelledby="calendarOverrideTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="calendarOverrideTitle">@L["Pages.AdminHouse.Calendar.OverrideTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Pages.AdminHouse.Calendar.Close"]"></button>
            </div>
            <div class="modal-body">
                @if (Model.AvailableCalendars.Count > 0)
                {
                    <h6>@L["Pages.AdminHouse.Calendar.UseExisting"]</h6>
                    <form method="post" action="/admin/houses/@houseId/calendar-override">
                        @Html.AntiForgeryToken()
                        <div class="input-group mb-3">
                            <select name="calendarId" class="form-select" required aria-label="@L["Pages.AdminHouse.Calendar.UseExisting"]">
                                <option value="">@L["Pages.AdminHouse.Calendar.SelectCalendar"]</option>
                                @foreach (var cal in Model.AvailableCalendars)
                                {
                                    var suffix = cal.IsTemplate ? $" [{L["Pages.AdminHouse.Calendar.Template"]}]" : string.Empty;
                                    <option value="@cal.Id" selected="@(cal.Id == Model.House.CalendarOverrideId)">
                                        @cal.Name (@L["Pages.AdminHouse.Calendar.SpanCount", cal.SpanCount])@suffix
                                    </option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary">@L["Pages.AdminHouse.Calendar.Apply"]</button>
                        </div>
                    </form>
                    <hr />
                }

                <h6>@L["Pages.AdminHouse.Calendar.CreateNew"]</h6>
                <form method="post" action="/admin/houses/@houseId/calendar-override/create">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <input type="text" name="name" class="form-control" placeholder="@L["Pages.AdminHouse.Calendar.NamePlaceholder"]" aria-label="@L["Pages.AdminHouse.Calendar.NamePlaceholder"]" />
                        <button type="submit" class="btn btn-outline-primary">@L["Pages.AdminHouse.Calendar.CreateApply"]</button>
                    </div>
                    <small class="text-body-secondary">@L["Pages.AdminHouse.Calendar.CreateHint"]</small>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Pages.AdminHouse.Calendar.Close"]</button>
            </div>
        </div>
    </div>
</div>
