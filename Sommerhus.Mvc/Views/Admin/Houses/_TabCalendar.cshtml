@using System.Globalization
@using Sommerhus.Core.Dtos.Shared
@using Sommerhus.Mvc.ViewModels.Admin.Houses
@model HouseDetailsVm

@{
    var seasonCodes = Model.SeasonCodes;
    var calendar = Model.House.Calendar ?? Array.Empty<SeasonSpanDto>();
    
    var labelLookup = seasonCodes.ToDictionary(
        c => c.Code,
        c => (Label: c.Label, Color: c.Color),
        StringComparer.OrdinalIgnoreCase);
}

<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5>Season Calendar</h5>
        @if (Model.House.GroupId.HasValue)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addHouseSeasonSpanModal">
                <i class="bi bi-plus-lg"></i> Add Season Span
            </button>
        }
        else
        {
            <small class="text-muted">Assign house to a group to manage season calendar</small>
        }
    </div>

    @if (calendar.Count == 0)
    {
        <p class="text-muted mb-0">
            @if (Model.House.GroupId.HasValue)
            {
                <text>No season spans defined for this house's group.</text>
            }
            else
            {
                <text>This house is not assigned to a group, so there is no shared season calendar.</text>
            }
        </p>
    }
    else
    {
        var currentYear = DateTime.Now.Year;
        var months = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
        
        <div class="mb-4">
            <h6 class="text-muted mb-2">Year Overview @currentYear</h6>
            <div class="d-flex flex-wrap gap-1">
                @for (int m = 1; m <= 12; m++)
                {
                    var monthStart = new DateOnly(currentYear, m, 1);
                    var monthEnd = monthStart.AddMonths(1).AddDays(-1);
                    var matchingSpan = calendar.FirstOrDefault(s => s.StartDate <= monthEnd && s.EndDate >= monthStart);
                    var spanColor = "#e9ecef";
                    var spanCode = "";
                    if (matchingSpan != null)
                    {
                        labelLookup.TryGetValue(matchingSpan.Code, out var meta);
                        spanColor = string.IsNullOrWhiteSpace(meta.Color) ? "#6c757d" : meta.Color;
                        spanCode = matchingSpan.Code;
                    }
                    <div class="text-center p-2 rounded" style="background-color: @spanColor; min-width: 60px; color: white; text-shadow: 0 0 2px rgba(0,0,0,0.5);">
                        <small class="d-block fw-bold">@months[m-1]</small>
                        @if (!string.IsNullOrEmpty(spanCode))
                        {
                            <small>@spanCode</small>
                        }
                    </div>
                }
            </div>
            <div class="mt-2 d-flex flex-wrap gap-2">
                @foreach (var code in seasonCodes.OrderBy(c => c.SortOrder))
                {
                    <small class="d-flex align-items-center gap-1">
                        <span class="rounded" style="width: 12px; height: 12px; display: inline-block; background-color: @(string.IsNullOrWhiteSpace(code.Color) ? "#6c757d" : code.Color);"></span>
                        @code.Code - @(code.Label ?? code.Code)
                    </small>
                }
            </div>
        </div>

        <h6 class="text-muted mb-2">Season Spans</h6>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Description</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        @if (Model.House.GroupId.HasValue)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var span in calendar.OrderBy(s => s.StartDate))
                    {
                        labelLookup.TryGetValue(span.Code, out var meta);
                        var label = meta.Label ?? span.Code;
                        var color = meta.Color;
                        <tr>
                            <td>
                                <span class="badge rounded-pill" style="background-color:@(string.IsNullOrWhiteSpace(color) ? "#6c757d" : color)">
                                    @span.Code
                                </span>
                            </td>
                            <td>@label</td>
                            <td>@span.StartDate.ToString("d", CultureInfo.CurrentCulture)</td>
                            <td>@span.EndDate.ToString("d", CultureInfo.CurrentCulture)</td>
                            @if (Model.House.GroupId.HasValue)
                            {
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary" 
                                                data-bs-toggle="modal" data-bs-target="#editHouseSeasonSpanModal"
                                                data-span-id="@span.Id"
                                                data-start-date="@span.StartDate.ToString("yyyy-MM-dd")"
                                                data-end-date="@span.EndDate.ToString("yyyy-MM-dd")"
                                                data-code="@span.Code">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form action="/admin/houses/@Model.House.Id/calendar/@span.Id/delete" 
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this season span?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.House.GroupId.HasValue)
{
    <div class="modal fade" id="addHouseSeasonSpanModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Season Span</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" action="/admin/houses/@Model.House.Id/calendar">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label for="HouseCode" class="form-label">Season Code *</label>
                            <select name="Code" id="HouseCode" class="form-select" required>
                                <option value="">Select season code</option>
                                @foreach (var code in seasonCodes.OrderBy(c => c.SortOrder).ThenBy(c => c.Code))
                                {
                                    <option value="@code.Code">@code.Code - @(code.Label ?? code.Code)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="HouseStartDate" class="form-label">Start Date *</label>
                            <input type="date" name="StartDate" id="HouseStartDate" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="HouseEndDate" class="form-label">End Date *</label>
                            <input type="date" name="EndDate" id="HouseEndDate" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add Span</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editHouseSeasonSpanModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Season Span</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" id="editHouseSeasonSpanForm">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="editHouseSpanId" name="spanId" />
                        
                        <div class="mb-3">
                            <label for="editHouseCode" class="form-label">Season Code *</label>
                            <select name="Code" id="editHouseCode" class="form-select" required>
                                <option value="">Select season code</option>
                                @foreach (var code in seasonCodes.OrderBy(c => c.SortOrder).ThenBy(c => c.Code))
                                {
                                    <option value="@code.Code">@code.Code - @(code.Label ?? code.Code)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="editHouseStartDate" class="form-label">Start Date *</label>
                            <input type="date" name="StartDate" id="editHouseStartDate" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="editHouseEndDate" class="form-label">End Date *</label>
                            <input type="date" name="EndDate" id="editHouseEndDate" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const editModal = document.getElementById('editHouseSeasonSpanModal');
            if (editModal) {
                editModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const spanId = button.getAttribute('data-span-id');
                    const startDate = button.getAttribute('data-start-date');
                    const endDate = button.getAttribute('data-end-date');
                    const code = button.getAttribute('data-code');

                    document.getElementById('editHouseSpanId').value = spanId;
                    document.getElementById('editHouseStartDate').value = startDate;
                    document.getElementById('editHouseEndDate').value = endDate;
                    document.getElementById('editHouseCode').value = code;

                    const form = document.getElementById('editHouseSeasonSpanForm');
                    form.action = `/admin/houses/@Model.House.Id/calendar/${spanId}`;
                });
            }
        });
    </script>
}
