@using System.Globalization
@using Sommerhus.Domain.Models
@using Sommerhus.Mvc.ViewModels.Admin.Houses
@model HouseDetailsVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L

@{
    var blocks = Model.AvailabilityBlocks ?? Array.Empty<Sommerhus.Core.Dtos.Shared.AvailabilityBlockDto>();

    // The order the status list is offered in; the labels come from the resource files.
    var statusOptions = new[]
    {
        AvailabilityStatus.Blocked,
        AvailabilityStatus.Tentative,
        AvailabilityStatus.Booked,
        AvailabilityStatus.Available
    };

    // Serialised so an apostrophe in the text cannot end the JavaScript string.
    var deleteConfirm = System.Text.Json.JsonSerializer.Serialize(L["Admin.Availability.DeleteConfirm"].Value);

    string BadgeClass(AvailabilityStatus status) => status switch
    {
        AvailabilityStatus.Available => "bg-success",
        AvailabilityStatus.Blocked => "bg-danger",
        AvailabilityStatus.Tentative => "bg-warning text-dark",
        AvailabilityStatus.Booked => "bg-secondary",
        _ => "bg-secondary"
    };
}

<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-1">@L["Admin.Tabs.Availability"]</h5>
            <p class="mb-0 text-muted small">
                @L["Admin.Availability.Showing", Model.AvailabilityFrom.ToString("d", CultureInfo.CurrentCulture), Model.AvailabilityTo.ToString("d", CultureInfo.CurrentCulture)]
            </p>
        </div>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAvailabilityBlockModal">
            <i class="bi bi-plus-lg"></i> @L["Admin.Availability.AddBlock"]
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.AvailabilityError))
    {
        <div class="alert alert-warning">@Model.AvailabilityError</div>
    }

    @if (!blocks.Any())
    {
        <p class="text-muted mb-0">@L["Admin.Availability.Empty"]</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>@L["Admin.Shared.Status"]</th>
                        <th>@L["Admin.Availability.Start"]</th>
                        <th>@L["Admin.Availability.End"]</th>
                        <th>@L["Admin.Availability.Source"]</th>
                        <th>@L["Admin.Availability.Note"]</th>
                        <th class="text-end">@L["Admin.Shared.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var block in blocks.OrderBy(b => b.StartDate))
                    {
                        <tr>
                            <td><span class="badge @BadgeClass(block.Status)">@L.Label(block.Status)</span></td>
                            <td>@block.StartDate.ToString("d", CultureInfo.CurrentCulture)</td>
                            <td>@block.EndDate.ToString("d", CultureInfo.CurrentCulture)</td>
                            <td>@L.Label(block.Source)</td>
                            <td>@(string.IsNullOrWhiteSpace(block.Note) ? "-" : block.Note)</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editAvailabilityBlockModal"
                                            data-block-id="@block.Id"
                                            data-start-date="@block.StartDate.ToString("yyyy-MM-dd")"
                                            data-end-date="@block.EndDate.ToString("yyyy-MM-dd")"
                                            data-status="@((int)block.Status)"
                                            data-note="@block.Note"
                                            aria-label="@L["Admin.Shared.Edit"]"
                                            title="@L["Admin.Shared.Edit"]">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </button>
                                    <form method="post"
                                          action="/admin/houses/@Model.House.Id/availability/@block.Id/delete"
                                          class="d-inline"
                                          onsubmit="return confirm(@deleteConfirm);">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" aria-label="@L["Admin.Shared.Delete"]" title="@L["Admin.Shared.Delete"]">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="modal fade" id="addAvailabilityBlockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["Admin.Availability.AddTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Shared.Close"]"></button>
            </div>
            <form method="post" action="/admin/houses/@Model.House.Id/availability">
                <div class="modal-body">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label" for="AvailabilityStartDate">@L["Admin.Availability.StartDate"] *</label>
                        <input type="date"
                               id="AvailabilityStartDate"
                               name="StartDate"
                               class="form-control"
                               value="@Model.AvailabilityFrom.ToString("yyyy-MM-dd")"
                               required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="AvailabilityEndDate">@L["Admin.Availability.EndDate"] *</label>
                        <input type="date"
                               id="AvailabilityEndDate"
                               name="EndDate"
                               class="form-control"
                               value="@Model.AvailabilityFrom.AddDays(2).ToString("yyyy-MM-dd")"
                               required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="AvailabilityStatus">@L["Admin.Shared.Status"] *</label>
                        <select name="Status" id="AvailabilityStatus" class="form-select" required>
                            @foreach (var option in statusOptions)
                            {
                                <option value="@((int)option)">@L.Label(option)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="AvailabilityNote">@L["Admin.Availability.Note"]</label>
                        <textarea name="Note" id="AvailabilityNote" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Admin.Shared.Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@L["Admin.Shared.Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editAvailabilityBlockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["Admin.Availability.EditTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Shared.Close"]"></button>
            </div>
            <form method="post" id="editAvailabilityBlockForm">
                <div class="modal-body">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label" for="EditAvailabilityStartDate">@L["Admin.Availability.StartDate"] *</label>
                        <input type="date" name="StartDate" id="EditAvailabilityStartDate" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="EditAvailabilityEndDate">@L["Admin.Availability.EndDate"] *</label>
                        <input type="date" name="EndDate" id="EditAvailabilityEndDate" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="EditAvailabilityStatus">@L["Admin.Shared.Status"] *</label>
                        <select name="Status" id="EditAvailabilityStatus" class="form-select" required>
                            @foreach (var option in statusOptions)
                            {
                                <option value="@((int)option)">@L.Label(option)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="EditAvailabilityNote">@L["Admin.Availability.Note"]</label>
                        <textarea name="Note" id="EditAvailabilityNote" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Admin.Shared.Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@L["Admin.Shared.SaveChanges"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const editModal = document.getElementById('editAvailabilityBlockModal');
        if (!editModal) {
            return;
        }

        editModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const blockId = button.getAttribute('data-block-id');
            const startDate = button.getAttribute('data-start-date');
            const endDate = button.getAttribute('data-end-date');
            const status = button.getAttribute('data-status');
            const note = button.getAttribute('data-note');

            document.getElementById('EditAvailabilityStartDate').value = startDate;
            document.getElementById('EditAvailabilityEndDate').value = endDate;
            document.getElementById('EditAvailabilityStatus').value = status;
            document.getElementById('EditAvailabilityNote').value = note || '';

            const form = document.getElementById('editAvailabilityBlockForm');
            form.action = `/admin/houses/@Model.House.Id/availability/${blockId}`;
        });
    });
</script>
