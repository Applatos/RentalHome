@using Sommerhus.Mvc.ViewModels.Admin.Houses
@model HouseDetailsVm

<div class="mb-4">
    <h5>Upload Images</h5>
    <form method="post" asp-controller="Houses" asp-action="UploadHouseImages" asp-route-id="@Model.House.Id" enctype="multipart/form-data" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-md-8">
            <input type="file" name="files" class="form-control" multiple accept="image/*" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary w-100">Upload</button>
        </div>
    </form>
</div>

@if (Model.House.Images?.Any() == true)
{
    <h5>Current Images</h5>
    <div class="row">
        @foreach (var img in Model.House.Images)
        {
            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card h-100">
                    <img src="@img.Url" class="card-img-top" alt="House image" style="height:150px;object-fit:cover;" />
                    <div class="card-body p-2">
                        <small class="text-muted">@(img.Kind ?? "gallery")</small>
                        <div class="btn-group w-100 mt-2">
                            <form method="post" asp-controller="Houses" asp-action="SetHouseImageKind" asp-route-id="@Model.House.Id" asp-route-imageId="@img.Id" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="kind" value="hero" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Set as hero">Hero</button>
                            </form>
                            <form method="post" asp-controller="Houses" asp-action="DeleteHouseImage" asp-route-id="@Model.House.Id" asp-route-imageId="@img.Id" class="d-inline" onsubmit="return confirm('Delete this image?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">No images uploaded yet.</p>
}
