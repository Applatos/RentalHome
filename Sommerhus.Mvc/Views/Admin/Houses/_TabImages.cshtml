@using Sommerhus.Mvc.ViewModels.Admin.Houses
@model HouseDetailsVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L

<div class="mb-4">
    <h5>@L["Admin.Images.UploadTitle"]</h5>
    <form method="post" asp-area="Admin" asp-controller="HouseImages" asp-action="UploadHouseImages" asp-route-id="@Model.House.Id" enctype="multipart/form-data" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-md-8">
            <input type="file" name="files" class="form-control" multiple accept="image/*" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary w-100">@L["Admin.Shared.Upload"]</button>
        </div>
    </form>
</div>

@if (Model.House.Images?.Any() == true)
{
    <h5>@L["Admin.Images.CurrentTitle"]</h5>
    <div class="row">
        @foreach (var img in Model.House.Images)
        {
            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card h-100">
                    <img src="@img.Url" class="card-img-top" alt="@L["Admin.Houses.Images.HouseImageAlt"]" style="height:150px;object-fit:cover;" />
                    <div class="card-body p-2">
                        <small class="text-muted">@(img.Kind ?? L["Admin.Images.GalleryKind"])</small>
                        <div class="btn-group w-100 mt-2">
                            @foreach (var kind in new[] { "Cover", "Gallery", "Floorplan" })
                            {
                                var isActive = string.Equals(img.Kind, kind, StringComparison.OrdinalIgnoreCase);
                                <form method="post" asp-area="Admin" asp-controller="HouseImages" asp-action="SetHouseImageKind" asp-route-id="@Model.House.Id" asp-route-imageId="@img.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="kind" value="@kind" />
                                    <button type="submit" class="btn btn-sm @(isActive ? "btn-secondary" : "btn-outline-secondary")" title="@L["Admin.Houses.Images.SetAs", kind]">@kind</button>
                                </form>
                            }
                        </div>
                        <div class="mt-1">
                            <form method="post" asp-area="Admin" asp-controller="HouseImages" asp-action="DeleteHouseImage" asp-route-id="@Model.House.Id" asp-route-imageId="@img.Id" class="d-inline" onsubmit="return confirm('@L["Admin.Images.DeleteConfirm"]');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100" title="@L["Admin.Shared.Delete"]">@L["Admin.Shared.Delete"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">@L["Admin.Images.Empty"]</p>
}
