@using System.Globalization
@using Sommerhus.Core.Dtos.Shared
@using Sommerhus.Mvc.ViewModels.Admin.Houses
@model HouseDetailsVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L

@{
    var plan = Model.House.Pricing;
    var seasonCodes = Model.SeasonCodes;
    var planPrices = plan?.SeasonPrices ?? Array.Empty<SeasonPriceDto>();
    var currency = string.IsNullOrWhiteSpace(plan?.Currency) ? "DKK" : plan.Currency.ToUpperInvariant();
    var check = Model.PricingCheck;

    var priceLookup = new Dictionary<string, SeasonPriceDto>(StringComparer.OrdinalIgnoreCase);
    foreach (var price in planPrices)
    {
        if (!priceLookup.ContainsKey(price.Code))
        {
            priceLookup[price.Code] = price;
        }
    }

    var displayRows = new List<(string Code, string? Label, string? Color, SeasonPriceDto? Price)>();
    foreach (var code in seasonCodes.OrderBy(c => c.SortOrder).ThenBy(c => c.Code, StringComparer.OrdinalIgnoreCase))
    {
        priceLookup.TryGetValue(code.Code, out var existingPrice);
        displayRows.Add((code.Code, code.Label, code.Color, existingPrice));
    }

    var knownCodes = new HashSet<string>(displayRows.Select(r => r.Code), StringComparer.OrdinalIgnoreCase);
    foreach (var price in planPrices.OrderBy(p => p.Code, StringComparer.OrdinalIgnoreCase))
    {
        if (knownCodes.Add(price.Code))
        {
            displayRows.Add((price.Code, price.Code, null, price));
        }
    }

    // "A (Højsæson)" for each season the calendar uses without a price.
    var labels = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
    foreach (var row in displayRows)
    {
        labels.TryAdd(row.Code, row.Label);
    }
    var unpricedSeasons = string.Join(", ", check.UnpricedCodes.Select(code =>
        labels.TryGetValue(code, out var label) && !string.IsNullOrWhiteSpace(label) && !string.Equals(label, code, StringComparison.OrdinalIgnoreCase)
            ? $"{code} ({label})"
            : code));
}

@if (!string.IsNullOrWhiteSpace(Model.SeasonCodesError))
{
    <div class="alert alert-warning">@Model.SeasonCodesError</div>
}

@if (!check.HasActivePlan)
{
    <div class="alert alert-warning" role="alert">@L["Pages.AdminHouse.Warning.NoActivePlan"]</div>
}
else if (check.UnpricedCodes.Count > 0)
{
    <div class="alert alert-warning" role="alert">@L["Pages.AdminHouse.Warning.UnpricedSeasons", unpricedSeasons]</div>
}

<form method="post" asp-controller="HousePricing" asp-action="SaveHousePricing" asp-route-id="@Model.House.Id" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="PlanId" value="@(plan?.PlanId.ToString() ?? string.Empty)" />

    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="plan-name">@L["Pages.AdminHouse.Pricing.PlanName"]</label>
            <input class="form-control" id="plan-name" name="Name" value="@(string.IsNullOrWhiteSpace(plan?.Name) ? "Standard" : plan.Name)" placeholder="Standard" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="plan-currency">@L["Pages.AdminHouse.Pricing.Currency"]</label>
            <select class="form-select" id="plan-currency" name="Currency">
                <option value="DKK" selected="@(currency == "DKK")">DKK</option>
                <option value="EUR" selected="@(currency == "EUR")">EUR</option>
                <option value="SEK" selected="@(currency == "SEK")">SEK</option>
                <option value="NOK" selected="@(currency == "NOK")">NOK</option>
                <option value="GBP" selected="@(currency == "GBP")">GBP</option>
                <option value="USD" selected="@(currency == "USD")">USD</option>
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(plan is null || plan.IsActive ? "checked" : null) id="plan-active" />
                <label class="form-check-label" for="plan-active">@L["Pages.AdminHouse.Pricing.Active"]</label>
            </div>
        </div>
        <div class="col-md-4 text-md-end">
            @if (plan is not null)
            {
                <small class="text-body-secondary d-block">@L["Pages.AdminHouse.Pricing.LastUpdated", (plan.UpdatedAtUtc ?? plan.CreatedAtUtc).ToLocalTime().ToString("g", CultureInfo.CurrentCulture)]</small>
            }
        </div>
    </div>

    <div class="table-responsive mt-3">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th class="w-25">@L["Pages.AdminHouse.Pricing.SeasonCode"]</th>
                    <th class="w-50">@L["Pages.AdminHouse.Pricing.Season"]</th>
                    <th class="w-25 text-end">@L["Pages.AdminHouse.Pricing.NightlyPrice", currency]</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < displayRows.Count; i++)
                {
                    var row = displayRows[i];
                    var price = row.Price?.NightlyPrice;
                    var idValue = row.Price?.Id.ToString() ?? string.Empty;
                    var ratePlanId = row.Price?.RatePlanId.ToString() ?? (plan?.PlanId.ToString() ?? string.Empty);
                    var label = string.IsNullOrWhiteSpace(row.Label) ? L["Pages.AdminHouse.Pricing.NoLabel"].Value : row.Label;
                    <tr>
                        <td>
                            <input type="hidden" name="SeasonPrices[@i].Code" value="@row.Code" />
                            <input type="hidden" name="SeasonPrices[@i].Id" value="@idValue" />
                            <input type="hidden" name="SeasonPrices[@i].RatePlanId" value="@ratePlanId" />
                            <span class="badge rounded-pill" style="background-color:@(string.IsNullOrWhiteSpace(row.Color) ? "#6c757d" : row.Color)">
                                @row.Code
                            </span>
                        </td>
                        <td>@label</td>
                        <td class="text-end">
                            <input type="number"
                                   step="0.01"
                                   min="0.01"
                                   inputmode="decimal"
                                   class="form-control text-end"
                                   name="SeasonPrices[@i].NightlyPrice"
                                   value="@(price.HasValue ? price.Value.ToString("0.##", CultureInfo.InvariantCulture) : string.Empty)"
                                   aria-label="@L["Pages.AdminHouse.Pricing.PriceFor", row.Code, label]"
                                   placeholder="0.00" />
                        </td>
                    </tr>
                }
                @if (displayRows.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-body-secondary text-center py-3">
                            @L["Pages.AdminHouse.Pricing.NoCodes"]
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="form-text">@L["Pages.AdminHouse.Pricing.Hint"]</p>

    <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-primary">@L["Pages.AdminHouse.Pricing.Save"]</button>
    </div>
</form>

@if (Model.PricingAuditEntries.Count > 0 || !string.IsNullOrWhiteSpace(Model.PricingAuditError))
{
    <hr class="my-4" />
    <h5>@L["Pages.AdminHouse.Pricing.History"]</h5>

    @if (!string.IsNullOrWhiteSpace(Model.PricingAuditError))
    {
        <div class="alert alert-warning">@Model.PricingAuditError</div>
    }

    <partial name="~/Views/Admin/Shared/_AuditHistoryTable.cshtml" model="Model.PricingAuditEntries" />
}
