@using Sommerhus.Mvc.ViewModels.Admin.Houses
@model HouseDetailsVm

@if (!string.IsNullOrWhiteSpace(Model.FeaturesError))
{
    <div class="alert alert-warning">@Model.FeaturesError</div>
}

<form method="post" asp-controller="Houses" asp-action="SaveHouseFeatures" asp-route-id="@Model.House.Id">
    @Html.AntiForgeryToken()

    @if (Model.AllFeatures.Count == 0)
    {
        <p class="text-muted">No features defined. <a asp-controller="Features" asp-action="Index">Create features first</a>.</p>
    }
    else
    {
        <div class="row">
            @foreach (var feature in Model.AllFeatures)
            {
                var existingValue = Model.House.Features?.FirstOrDefault(f => f.Id == feature.Id);
                var inputName = $"feature_{feature.Id}";
                var currentValue = existingValue?.RawValue ?? string.Empty;

                <div class="col-md-6 col-lg-4 mb-3">
                    <label class="form-label">
                        @if (!string.IsNullOrWhiteSpace(feature.IconUrl))
                        {
                            <img src="@feature.IconUrl" alt="" style="height:18px;width:auto;margin-right:4px;" />
                        }
                        @feature.Name
                        @if (!string.IsNullOrWhiteSpace(feature.Unit))
                        {
                            <small class="text-muted">(@feature.Unit)</small>
                        }
                    </label>

                    @switch (feature.ValueType?.ToLowerInvariant())
                    {
                        case "bool":
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="@inputName" value="true" 
                                       checked="@(currentValue.Equals("true", StringComparison.OrdinalIgnoreCase))" />
                                <label class="form-check-label">Yes</label>
                            </div>
                            break;
                        case "int":
                        case "decimal":
                            <input type="number" class="form-control" name="@inputName" value="@currentValue" 
                                   step="@(feature.ValueType?.ToLowerInvariant() == "decimal" ? "0.01" : "1")" />
                            break;
                        default:
                            <input type="text" class="form-control" name="@inputName" value="@currentValue" maxlength="200" />
                            break;
                    }
                </div>
            }
        </div>

        <div class="mt-3">
            <button class="btn btn-primary">Save Features</button>
        </div>
    }
</form>
