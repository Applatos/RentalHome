@model Sommerhus.Mvc.Controllers.AdminController.CreateFormVM

<div class="mb-2">
    <label class="form-label">Titel</label>
    <input asp-for="Title" class="form-control" />
</div>
<div class="mb-2">
    <label class="form-label">Undertitel</label>
    <input asp-for="Subtitle" class="form-control" />
</div>
<div class="mb-2">
    <label class="form-label">Adresse</label>
    <input asp-for="Address" class="form-control" />
</div>
<div class="mb-2">
    <label class="form-label">By</label>
    <input asp-for="City" class="form-control" />
</div>
<div class="mb-2">
    <label class="form-label">Postnr</label>
    <input asp-for="Zip" class="form-control" />
</div>
<div class="mb-2">
    <label class="form-label">Beskrivelse</label>
    <textarea asp-for="Description" class="form-control"></textarea>
</div>
<div class="mb-2">
    <label class="form-label">Faciliteter</label>
    <textarea asp-for="Facilities" class="form-control"></textarea>
</div>
