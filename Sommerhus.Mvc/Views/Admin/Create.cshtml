@model Sommerhus.Mvc.Controllers.AdminController.CreateFormVM
@{
    ViewData["Title"] = "Opret hus";
}
<div class="container py-4">
    <h3>Opret hus</h3>
    <form method="post" action="/admin/create">
        @Html.AntiForgeryToken()

        <partial name="_HouseFormFields" model="Model" />

        <div class="mt-3">
            <button class="btn btn-dark">Opret</button>
            <a class="btn btn-outline-secondary" href="/admin">Annullér</a>
        </div>
    </form>
</div>
