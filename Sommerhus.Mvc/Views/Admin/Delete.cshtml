@model Sommerhus.Mvc.Services.HouseDetails
@{
    ViewData["Title"] = "Slet hus";
}
<div class="container py-4">
    <h3>Slet hus</h3>
    <p>Er du sikker på, at du vil slette <strong>@Model.Title</strong>?</p>
    <form method="post" action="/admin/@Model.Id/delete">
        @Html.AntiForgeryToken()
        <button class="btn btn-danger">Slet</button>
        <a class="btn btn-outline-secondary" href="/admin">Annullér</a>
    </form>
</div>
