@* @model Sommerhus.Mvc.Controllers.AdminController.CreateFormVM

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Titel</label>
        <input class="form-control" asp-for="Title" />
        <span class="text-danger" asp-validation-for="Title"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Undertitel</label>
        <input class="form-control" asp-for="Subtitle" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Adresse</label>
        <input class="form-control" asp-for="Address" />
    </div>
    <div class="col-md-6">
        <label class="form-label">By</label>
        <input type="hidden" asp-for="CityId" id="house-city-id" />
        <input type="text"
               class="form-control"
               name="CitySearch"
               id="house-city-search"
               value="@Model.CitySearch"
               placeholder="Søg by eller postnr…"
               autocomplete="off"
               data-url="/admin/cities/search" />
        <datalist id="house-city-options"></datalist>
        <span class="text-danger" asp-validation-for="CityId"></span>
    </div>
    <div class="col-12">
        <label class="form-label">Beskrivelse</label>
        <textarea class="form-control" rows="6" asp-for="Description"></textarea>
    </div>
    <div class="col-12">
        <label class="form-label">Faciliteter (tekst)</label>
        <textarea class="form-control" rows="3" asp-for="Facilities"></textarea>
    </div>
</div>

<script>
    (() => {
        const input = document.getElementById('house-city-search');
        const hidden = document.getElementById('house-city-id');
        const list = document.getElementById('house-city-options');
        if (!input || !hidden || !list || input.dataset.bound === 'true') {
            return;
        }

        input.dataset.bound = 'true';

        let suggestions = [];
        let controller = null;

        const renderOptions = (items) => {
            list.innerHTML = '';
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.label;
                list.appendChild(option);
            });
        };

        const lookup = async (term) => {
            const url = input.dataset.url + '?q=' + encodeURIComponent(term);
            if (controller) controller.abort();
            controller = new AbortController();
            try {
                const res = await fetch(url, { signal: controller.signal });
                if (!res.ok) return;
                suggestions = await res.json();
                renderOptions(suggestions);
            } catch (err) {
                if (err.name !== 'AbortError') {
                    console.error(err);
                }
            }
        };

        const trySelect = (value) => {
            const match = suggestions.find(s => s.label === value);
            if (match) {
                hidden.value = match.id;
            }
        };

        input.addEventListener('input', () => {
            const value = input.value.trim();
            hidden.value = '';
            if (value.length >= 2) {
                lookup(value);
            } else {
                suggestions = [];
                renderOptions([]);
            }
        });

        input.addEventListener('change', () => {
            trySelect(input.value.trim());
        });

        input.addEventListener('blur', () => {
            if (!hidden.value) {
                trySelect(input.value.trim());
            }
        });
    })();
</script>
 *@