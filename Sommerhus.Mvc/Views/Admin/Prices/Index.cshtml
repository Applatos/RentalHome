@using System.Linq
@using Sommerhus.Core.Dtos.Shared
@using Sommerhus.Mvc.ViewModels.Admin.Prices
@model PricingAdminVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L

@{
    ViewData["Title"] = L["Admin.Prices.PageTitle"];
}

<section class="container my-3">

    @await Html.PartialAsync("~/Views/Admin/Shared/_FlashMessages.cshtml")
    @await Html.PartialAsync("~/Views/Admin/Shared/_AdminTabs.cshtml")

    <h2 class="mb-4">@L["Admin.Prices.Title"]</h2>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-body-secondary">
                    <strong>@L["Admin.Prices.SeasonCodes.Title"]</strong>
                </div>
                <div class="card-body">
                    <p class="text-muted">@L["Admin.Prices.SeasonCodes.Help"]</p>
                    <form method="post" asp-action="CreateSeasonCode" asp-controller="Prices">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="SeasonCodeForm.Code" class="form-label">@L["Admin.Prices.SeasonCodes.Code"]</label>
                                <input asp-for="SeasonCodeForm.Code" class="form-control text-uppercase" maxlength="10" placeholder="A" />
                                <span asp-validation-for="SeasonCodeForm.Code" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="SeasonCodeForm.Label" class="form-label">@L["Admin.Shared.Name"]</label>
                                <input asp-for="SeasonCodeForm.Label" class="form-control" placeholder="Højsæson" />
                                <span asp-validation-for="SeasonCodeForm.Label" class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="SeasonCodeForm.Color" class="form-label">@L["Admin.Prices.SeasonCodes.Color"]</label>
                                <input asp-for="SeasonCodeForm.Color" class="form-control text-uppercase" placeholder="#FF5733" />
                                <span asp-validation-for="SeasonCodeForm.Color" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SeasonCodeForm.SortOrder" class="form-label">@L["Admin.Prices.SeasonCodes.SortOrder"]</label>
                                <input asp-for="SeasonCodeForm.SortOrder" class="form-control" type="number" min="0" />
                                <span asp-validation-for="SeasonCodeForm.SortOrder" class="text-danger"></span>
                            </div>
                        </div>
                        <button class="btn btn-primary mt-3">@L["Admin.Prices.SeasonCodes.Create"]</button>
                    </form>

                    @if (!string.IsNullOrWhiteSpace(Model.SeasonError))
                    {
                        <div class="alert alert-warning mt-3">@Model.SeasonError</div>
                    }

                    <hr />

                    <h6 class="text-uppercase text-muted">@L["Admin.Prices.SeasonCodes.Existing"]</h6>
                    @if (Model.SeasonCodes.Count == 0)
                    {
                        <p class="text-muted">@L["Admin.Prices.SeasonCodes.Empty"]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>@L["Admin.Prices.SeasonCodes.Code"]</th>
                                        <th>@L["Admin.Shared.Name"]</th>
                                        <th>@L["Admin.Prices.SeasonCodes.Color"]</th>
                                        <th class="text-end">@L["Admin.Prices.SeasonCodes.SortOrder"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var code in Model.SeasonCodes.OrderBy(c => c.SortOrder).ThenBy(c => c.Code))
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge rounded-pill" style="background-color:@(string.IsNullOrWhiteSpace(code.Color) ? "#6c757d" : code.Color)">@code.Code</span>
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(code.Label) ? L["Admin.Shared.None"] : code.Label)</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(code.Color))
                                                {
                                                    <span class="badge" style="background-color:@code.Color">@code.Color</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="text-end">@code.SortOrder</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
