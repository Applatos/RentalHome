@using AdmFeats = Sommerhus.Contracts.Dtos.Admin.Features
@model IReadOnlyList<AdmFeats.FeatureDetailsDto>

<section class="container my-3">
    @await Html.PartialAsync("_AdminTabs")
    <h2 class="mb-3">Features</h2>

    @if (TempData["Ok"] is string okMsg)
    { <div class="alert alert-success">@okMsg</div> }
    @if (TempData["Err"] is string errMsg)
    { <div class="alert alert-danger">@errMsg</div> }

    <!-- Opret ny feature -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Opret ny feature</h5>
            <form method="post" asp-action="CreateFeature" asp-controller="Admin" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-md-3">
                    <label class="form-label">Navn *</label>
                    <input name="Name" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Key *</label>
                    <input name="Key" class="form-control" placeholder="f.eks. sauna" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Type *</label>
                    <select name="ValueType" class="form-select" required>
                        <option value="Bool">Bool</option>
                        <option value="Number">Number</option>
                        <option value="Text" selected>Text</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Enhed</label>
                    <input name="Unit" class="form-control" placeholder="f.eks. m2, km" />
                </div>
                <div class="col-md-12 mt-2">
                    <button class="btn btn-dark">Opret</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Eksisterende features -->
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Key</th>
                <th>Type</th>
                <th>Unit</th>
                <th style="width:220px;">Ikon</th>
                <th style="width:140px;"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var f in Model)
        {
            var inputId = $"file_{f.Id}";
            <tr>
                <td>@f.Name</td>
                <td>@f.Key</td>
                <td>@f.ValueType</td>
                <td>@f.Unit</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div>
                                @if (!string.IsNullOrWhiteSpace(f.IconUrl))
                                {
                                    <img src="@f.IconUrl" alt="ikon" style="height:24px;width:auto" />
                                }
                                else
                                {

                                    <span>intet ikon</span>
                                }
                        </div>

                        <!-- Drag&Drop / File picker -->
                        <form method="post" asp-action="UploadFeatureIcon" asp-controller="Admin"
                              asp-route-id="@f.Id" enctype="multipart/form-data" class="feature-upload-form">
                            @Html.AntiForgeryToken()
                            <input id="@inputId" type="file" name="file" class="d-none feature-file-input" accept="image/*" />
                            <div class="dropzone small" data-input="#@inputId" title="Træk billede hertil eller klik">
                                Træk billede hertil eller <u>vælg fil</u>
                            </div>
                        </form>
                    </div>
                </td>
                <td class="text-end">
                    <form method="post" asp-action="DeleteFeature" asp-controller="Admin" asp-route-id="@f.Id">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger">Slet</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</section>

@section Styles {
<style>
    .dropzone {
        border: 2px dashed #bbb;
        border-radius: .5rem;
        padding: .4rem .6rem;
        cursor: pointer;
        user-select: none;
        text-align: center;
        transition: background-color .15s ease-in-out, border-color .15s ease-in-out;
    }
    .dropzone.small { min-width: 160px; }
    .dropzone.dragover { background-color: #f5f5f5; border-color: #666; }
</style>
}
@section Scripts {
<script>
(function () {
    function bySel(sel, root) { return (root || document).querySelector(sel); }
    function allSel(sel, root) { return Array.from((root || document).querySelectorAll(sel)); }

    // Klik på dropzone åbner filvælger
    allSel('.dropzone').forEach(zone => {
        const inputSel = zone.getAttribute('data-input');
        const form = zone.closest('form');
        const input = bySel(inputSel, form);

        zone.addEventListener('click', () => input.click());

        zone.addEventListener('dragover', e => {
            e.preventDefault();
            zone.classList.add('dragover');
        });
        zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
        zone.addEventListener('drop', e => {
            e.preventDefault();
            zone.classList.remove('dragover');
            if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                input.files = e.dataTransfer.files;
                form.submit();
            }
        });

        input.addEventListener('change', () => {
            if (input.files && input.files.length > 0) form.submit();
        });
    });
})();
</script>
}
