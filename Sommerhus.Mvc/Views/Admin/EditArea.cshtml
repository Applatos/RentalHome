@model Sommerhus.Mvc.Controllers.Admin.AreaEditVm

<section class="container my-3">
    @await Html.PartialAsync("_AdminTabs")

    <a class="btn btn-link" asp-controller="Admin" asp-action="Areas">◂ Tilbage</a>


    @if (TempData["Err"] is string errMsg){<div class="alert alert-danger">@errMsg</div>}
    @if (TempData["Ok"] is string okMsg){<div class="alert alert-success">@okMsg</div>}

    <h3 class="mb-3">@(Model.IsNew ? "Opret area" : $"Rediger: {Model.Name}")</h3>

    <form method="post"
          asp-controller="Admin"
          asp-action="@(Model.IsNew ? "CreateArea" : "UpdateArea")"
          asp-route-id="@(Model.IsNew ? null : Model.Id)">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Navn *</label>
            <input asp-for="Name" class="form-control" required maxlength="100" />
        </div>

        <div class="mb-3">
            <label asp-for="CityId" class="form-label">Tilknyttet by</label>
            <select asp-for="CityId" class="form-select" asp-items="Model.Cities"></select>
            <div class="form-text">Vælg byen området hører til (valgfrit).</div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Beskrivelse</label>
            <textarea asp-for="Description" class="form-control" rows="6"></textarea>
            <div class="form-text">HTML tilladt.</div>
        </div>

        @if (!Model.IsNew && Model.Images?.Count > 0)
        {
            <div class="mb-3">
                <label class="form-label">Billeder</label>
                <div class="row row-cols-2 row-cols-md-4 g-2">
                    @foreach (var image in Model.Images)
                    {
                        <div class="col">
                            <img src="@image.Url" class="img-fluid rounded" alt="Area image" />
                        </div>
                    }
                </div>
            </div>
        }


        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">@(Model.IsNew ? "Opret" : "Gem ændringer")</button>
            <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Areas">Annullér</a>
        </div>
    </form>
</section>
