@using Sommerhus.Mvc.Controllers.Admin
@using Sommerhus.Mvc.Services
@using Sommerhus.Mvc.ViewModels.Admin.Areas
@model AreaEditVm


<section class="container my-3">
    @await Html.PartialAsync("_AdminTabs")

    <a class="btn btn-link" asp-controller="Areas" asp-action="Index">◂ Tilbage</a>


    @if (TempData["Err"] is string errMsg){<div class="alert alert-danger">@errMsg</div>}
    @if (TempData["Ok"] is string okMsg){<div class="alert alert-success">@okMsg</div>}

    <h3 class="mb-3">@(Model.IsNew ? "Opret area" : $"Rediger: {Model.Name}")</h3>

    <form method="post"
          asp-controller="Areas"
          asp-action="@(Model.IsNew ? "Create" : "Update")"
          asp-route-id="@(Model.IsNew ? null : Model.Id)">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Navn *</label>
            <input asp-for="Name" class="form-control" required maxlength="100" />
        </div>

        <div class="mb-3">
            <label asp-for="CityIds" class="form-label">Tilknyttede byer</label>
            <select asp-for="CityIds" class="form-select" asp-items="Model.Cities" multiple></select>
            <div class="form-text">Vælg én eller flere byer området dækker</div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Beskrivelse</label>
            <textarea asp-for="Description" class="form-control" rows="6"></textarea>
            <div class="form-text">HTML tilladt.</div>
        </div>

        @if (!Model.IsNew && Model.Id is Guid areaId)
        {
            <hr class="my-4" />
            <h4>Billedgalleri</h4>
            @await Html.PartialAsync("~/Views/Admin/Area._Images.cshtml", new AreaGalleryVm(areaId, Model.Images, "edit"))
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">@(Model.IsNew ? "Opret" : "Gem ændringer")</button>
            <a class="btn btn-outline-secondary" asp-controller="Areas" asp-action="Index">Annullér</a>
        </div>
    </form>
</section>
