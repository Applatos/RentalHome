@model Sommerhus.Mvc.Controllers.AdminController.AreaMasterVm

@if (Model.Items.Count == 0)
{
    <div class="text-muted">Ingen områder fundet.</div>
}
else
{
    <div class="list-group list-group-flush">
        @foreach (var a in Model.Items)
        {
            <a href="#"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
               hx-get="/admin/areas/@a.Id/detail"
               hx-target="#areas-detail"
               hx-swap="innerHTML">
                <span>
                    <div>@a.Name</div>
                    <div class="text-muted small">@a.Slug</div>
                </span>
                <small class="text-muted">@a.HouseCount huse · @a.ImageCount billeder</small>
            </a>
        }
    </div>
}
