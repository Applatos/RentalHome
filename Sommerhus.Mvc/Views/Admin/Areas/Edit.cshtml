@using Sommerhus.Mvc.ViewModels.Admin.Areas
@model AreaEditVm

<section class="container my-3">
    @await Html.PartialAsync("~/Views/Admin/Shared/_AdminTabs.cshtml")

    <a class="btn btn-link" asp-controller="Areas" asp-action="Index">← Back</a>
    <partial name="~/Views/Admin/Shared/_FlashMessages.cshtml" />

    <h3 class="mb-3">@(Model.IsNew ? "Create Area" : $"Edit: {Model.Name}")</h3>

    <form method="post"
          asp-controller="Areas"
          asp-action="@(Model.IsNew ? "Create" : "Update")"
          asp-route-id="@(Model.IsNew ? null : Model.Id)">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name *</label>
            <input asp-for="Name" class="form-control" required maxlength="100" />
        </div>

        <div class="mb-3">
            <label asp-for="CityIds" class="form-label">Associated Cities</label>
            <select asp-for="CityIds" class="form-select" asp-items="Model.Cities" multiple></select>
            <div class="form-text">Select one or more cities the area covers</div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="6"></textarea>
            <div class="form-text">HTML allowed.</div>
        </div>

        @if (!Model.IsNew && Model.Id is Guid areaId)
        {
            <hr class="my-4" />
            <h4>Image Gallery</h4>
            <partial name="~/Views/Admin/Areas/_EditImages.cshtml" model="@(new AreaGalleryVm(areaId, Model.Images, "edit"))" />
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">@(Model.IsNew ? "Create" : "Save Changes")</button>
            <a class="btn btn-outline-secondary" asp-controller="Areas" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
