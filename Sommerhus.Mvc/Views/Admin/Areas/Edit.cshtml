@model Sommerhus.Mvc.Models.Admin.AreaFormViewModel

<section class="container my-3">
    <a class="btn btn-link" href="@Url.Action("Area", "Admin", new { id = Model.Id })">◂ Tilbage til detaljer</a>
    <div class="row">
        <div class="col-lg-7 col-xl-6">
            <h3 class="mb-3">@Model.Title</h3>
            <form asp-action="EditArea" asp-controller="Admin" asp-route-id="@Model.Id" method="post" class="vstack gap-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <partial name="~/Views/Admin/Areas/_Form.cshtml" model="Model" />
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit">@Model.SubmitText</button>
                    <a class="btn btn-outline-secondary" href="@Url.Action("Area", "Admin", new { id = Model.Id })">Annullér</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
