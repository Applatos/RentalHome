@using Sommerhus.Mvc.ViewModels.Admin.Areas
@model AreaCreateVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@{
    ViewData["Title"] = L["Admin.Areas.Create.PageTitle"];
}

<section class="container my-3">
    @await Html.PartialAsync("~/Views/Admin/Shared/_AdminTabs.cshtml")
    @await Html.PartialAsync("~/Views/Admin/Shared/_FlashMessages.cshtml")

    <h2 class="mb-3">@L["Admin.Areas.Create.Title"]</h2>

    <form method="post" asp-controller="Areas" asp-action="Create" class="row g-3">
        @Html.AntiForgeryToken()

        <div class="col-md-8">
            <label class="form-label">@L["Admin.Shared.Name"]</label>
            <input class="form-control" asp-for="Area.Name" required maxlength="100" />
            <span class="text-danger" asp-validation-for="Area.Name"></span>
        </div>

        <div class="col-md-8">
            <label class="form-label">@L["Admin.Shared.NameEn"]</label>
            <input class="form-control" asp-for="Area.NameEn" maxlength="100" />
            <span class="text-danger" asp-validation-for="Area.NameEn"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">@L["Admin.Areas.Form.AssociatedCities"]</label>
            <select class="form-select" asp-for="Area.CityIds" asp-items="Model.Cities" multiple></select>
            <div class="form-text">@L["Admin.Shared.MultiSelectHint"]</div>
        </div>

        <div class="col-md-12">
            <label class="form-label">@L["Admin.Shared.Description"]</label>
            <textarea class="form-control" asp-for="Area.Description" rows="4"></textarea>
            <span class="text-danger" asp-validation-for="Area.Description"></span>
            <div class="form-text">@L["Admin.Shared.HtmlAllowed"]</div>
        </div>

        <div class="col-12 d-flex gap-2">
            <button class="btn btn-primary">@L["Admin.Shared.Create"]</button>
            <a class="btn btn-outline-secondary" asp-controller="Areas" asp-action="Index">@L["Admin.Shared.BackToList"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}