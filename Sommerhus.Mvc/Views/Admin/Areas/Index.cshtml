@using Sommerhus.Mvc.ViewModels.Admin.Areas
@model AreaListVm

<section class="container my-3">
    @await Html.PartialAsync("~/Views/Admin/Shared/_AdminTabs.cshtml")
    <partial name="~/Views/Admin/Shared/_FlashMessages.cshtml" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Areas</h2>
        <a class="btn btn-primary" asp-controller="Areas" asp-action="Create">+ Create Area</a>
    </div>

    @if (Model.Areas.Count == 0)
    {
        <p class="text-muted">No areas found yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Houses</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Areas)
                    {
                        var confirmText = System.Text.Json.JsonSerializer.Serialize($"Delete area \"{a.Name}\"?");
                        <tr>
                            <td class="fw-semibold">@a.Name</td>
                            <td>@a.HouseCount</td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-outline-dark btn-sm" 
                                        asp-controller="Areas" 
                                        asp-action="Details" 
                                        asp-route-id="@a.Id">Details</a>

                                    <a class="btn btn-outline-secondary btn-sm" 
                                        asp-controller="Areas" 
                                        asp-action="Edit" 
                                        asp-route-id="@a.Id">Edit</a>

                                    <form asp-controller="Areas"
                                          asp-action="Delete"
                                          asp-route-id="@a.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm(@confirmText);">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
