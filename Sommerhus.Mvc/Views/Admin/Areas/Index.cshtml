@using Sommerhus.Mvc.ViewModels.Admin.Areas
@model AreaListVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L

<section class="container my-3">
    @await Html.PartialAsync("~/Views/Admin/Shared/_AdminTabs.cshtml")
    <partial name="~/Views/Admin/Shared/_FlashMessages.cshtml" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@L["Admin.Areas.Index.Title"]</h2>
        <a class="btn btn-primary" asp-controller="Areas" asp-action="New">+ @L["Admin.Areas.Index.Create"]</a>
    </div>

    @if (Model.Areas.Count == 0)
    {
        <p class="text-muted">@L["Admin.Areas.Index.Empty"]</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">@L["Admin.Shared.Name"]</th>
                        <th scope="col">@L["Admin.Shared.Houses"]</th>
                        <th scope="col" class="text-end">@L["Admin.Shared.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Areas)
                    {
                        var confirmText = System.Text.Json.JsonSerializer.Serialize(string.Format(L["Admin.Areas.Index.DeleteConfirm"], a.Name));
                        <tr>
                            <td class="fw-semibold">@a.Name</td>
                            <td>@a.HouseCount</td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-outline-dark btn-sm" 
                                        asp-controller="Areas" 
                                        asp-action="Details" 
                                        asp-route-id="@a.Id">@L["Admin.Shared.Details"]</a>

                                    <form asp-controller="Areas"
                                          asp-action="Delete"
                                          asp-route-id="@a.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm(@confirmText);">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">@L["Admin.Shared.Delete"]</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
