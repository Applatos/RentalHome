@model Sommerhus.Mvc.Models.Admin.AreaFormViewModel

<div class="mb-3">
    <label asp-for="Input.Name" class="form-label"></label>
    <input asp-for="Input.Name" class="form-control" />
    <span asp-validation-for="Input.Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Input.CityId" class="form-label"></label>
    <select asp-for="Input.CityId" class="form-select" asp-items="Model.Cities">
        <option value="">Ingen</option>
    </select>
    <span asp-validation-for="Input.CityId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Input.Description" class="form-label"></label>
    <textarea asp-for="Input.Description" class="form-control" rows="5"></textarea>
    <span asp-validation-for="Input.Description" class="text-danger"></span>
</div>

@if (Model.IsEdit && !string.IsNullOrWhiteSpace(Model.Slug))
{
    <div class="mb-3">
        <span class="form-text">Nuværende slug: <code>@Model.Slug</code></span>
    </div>
}
