@using Sommerhus.Mvc.Controllers.Admin;

@model SeasonRow
@{
    var idx = (string)ViewData["Index"];                 // unikt token
    ViewData.TemplateInfo.HtmlFieldPrefix = $"Seasons[{idx}]";
}

<input type="hidden" name="Seasons.Index" value="@idx" />

<input asp-for="Id" type="hidden" />

<!-- Fjern: checkbox + CSS :has() -->
<input asp-for="IsDeleted" type="checkbox" class="d-none del-flag" id="del-@idx" value="true" />
<label for="del-@idx" class="btn btn-outline-danger btn-sm">Fjern</label>

<input asp-for="Name" class="form-control" placeholder="Sommer" />
<input asp-for="StartDate" type="date" class="form-control" />
<input asp-for="EndDate" type="date" class="form-control" />
<input asp-for="NightlyPrice" type="number" step="0.01" min="0" class="form-control" />
<input asp-for="MinStayNights" type="number" step="1" min="1" class="form-control" />

<span class="text-danger" asp-validation-for="Name"></span>
