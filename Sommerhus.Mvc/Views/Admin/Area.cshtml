@using Sommerhus.Contracts.Dtos.Admin.Areas
@model AreaDetailsDto
<section class="container my-3">
    @await Html.PartialAsync("_AdminTabs")

    <a class="btn btn-link" asp-controller="Admin" asp-action="Areas">◂ Tilbage</a>
    <h3>@Model.Name</h3>
    <dl class="row small">
        <dt class="col-sm-2">Byer</dt>
        <dd class="col-sm-10">
            @if (Model.Cities?.Any() == true)
            {
                <span>@string.Join(", ", Model.Cities.Select(c => c.Label))</span>
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </dd>
    </dl>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="mb-3">@Html.Raw(Model.Description)</div>
    }

    @if (Model.Images?.Any() == true)
    {
        <div class="row row-cols-2 row-cols-md-4 g-2">
            @foreach (var img in Model.Images)
            {
                <div class="col">
                    <img src="@img.Url" class="img-fluid rounded" />
                </div>
            }
        </div>
    }
</section>
