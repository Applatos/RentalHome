@using System.Linq
@using AdmAreas = Sommerhus.Contracts.Dtos.Admin.Areas
@model AdmAreas.AreaDetailsDto
@{
    var success = ViewBag.AreaSuccess as string;
    var error = ViewBag.AreaError as string;
}
<section class="container my-3">
    <a class="btn btn-link" href="@Url.Action("Areas", "Admin")">◂ Tilbage til liste</a>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">@Model.Name</h3>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="@Url.Action("EditArea", "Admin", new { id = Model.Id })">Redigér</a>
            <form method="post" action="@Url.Action("DeleteArea", "Admin", new { id = Model.Id })" onsubmit="return confirm('Slet dette område?');">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-danger" type="submit">Slet</button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(success))
    {
        <div class="alert alert-success" role="alert">@success</div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="border rounded p-3 h-100">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Slug</dt>
                    <dd class="col-sm-8 text-break">@Model.Slug</dd>

                    <dt class="col-sm-4">By</dt>
                    <dd class="col-sm-8">@(Model.CityName ?? "Ingen by angivet")</dd>

                    <dt class="col-sm-4">Beskrivelse</dt>
                    <dd class="col-sm-8 text-prewrap">@(!string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : "Ingen beskrivelse angivet.")</dd>
                </dl>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded p-3 h-100">
                <h5>Billedgalleri</h5>
                <form data-area-upload="@Model.Id" class="d-flex gap-2 align-items-center mb-3">
                    <input type="file" name="file" accept="image/*" class="form-control form-control-sm" />
                    <button class="btn btn-sm btn-outline-secondary" type="submit">Upload</button>
                </form>

                @if (Model.Images?.Any() == true)
                {
                    <div class="row row-cols-2 row-cols-md-3 g-2">
                        @foreach (var img in Model.Images)
                        {
                            <div class="col">
                                <div class="border rounded p-2 h-100 d-flex flex-column">
                                    <img src="@img.Url" class="img-fluid rounded mb-2" alt="" style="object-fit:cover;height:120px;" />
                                    <form data-area-id="@Model.Id" data-area-image-id="@img.Id" class="mt-auto">
                                        <button class="btn btn-sm btn-outline-danger w-100" type="submit">Slet</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">Ingen billeder endnu.</div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const uploadForm = document.querySelector("form[data-area-upload]");
        if (uploadForm) {
            uploadForm.addEventListener("submit", async function (ev) {
                ev.preventDefault();
                const areaId = uploadForm.getAttribute("data-area-upload");
                const fileInput = uploadForm.querySelector('input[type="file"]');
                if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                    alert("Vælg et billede først.");
                    return;
                }
                const formData = new FormData();
                formData.append("file", fileInput.files[0]);
                const res = await fetch(`/api/admin/areas/${areaId}/images`, {
                    method: "POST",
                    body: formData
                });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert("Kunne ikke uploade billede.");
                }
            });
        }

        document.querySelectorAll("form[data-area-image-id]").forEach(function (form) {
            form.addEventListener("submit", async function (ev) {
                ev.preventDefault();
                if (!confirm("Slet billede?")) {
                    return;
                }
                const areaId = form.getAttribute("data-area-id");
                const imageId = form.getAttribute("data-area-image-id");
                const res = await fetch(`/api/admin/areas/${areaId}/images/${imageId}`, {
                    method: "DELETE"
                });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert("Kunne ikke slette billede.");
                }
            });
        });
    });
</script>
}
