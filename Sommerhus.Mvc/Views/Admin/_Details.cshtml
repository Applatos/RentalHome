@model Sommerhus.Mvc.Controllers.AdminController.DetailVm
@{
    var h = Model.House;
}
@Html.AntiForgeryToken()

<div class="mb-2 d-flex justify-content-between align-items-center">
    <h5 class="mb-0">@h.Title</h5>
    <span class="text-muted">@h.City @h.Zip</span>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="ratio ratio-16x9 rounded bg-light">
            @if (!string.IsNullOrWhiteSpace(h.CoverUrl))
            {
                <img class="w-100 h-100" style="object-fit:cover" src="@h.CoverUrl" />
            }
            else
            {

                <div class="d-flex align-items-center justify-content-center text-muted">Intet cover</div>
            }
        </div>
        <div class="mt-2">
            <a class="btn btn-sm btn-outline-primary" href="/admin/@h.Id/edit">Redigér stamdata</a>
            <a class="btn btn-sm btn-outline-primary" href="/admin/@h.Id/images">Billeder</a>
            <a class="btn btn-sm btn-outline-primary" href="/admin/@h.Id/features">Features</a>
            <a class="btn btn-sm btn-outline-danger" href="/admin/@h.Id/delete">Slet</a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-2"><strong>Adresse</strong><br />@h.Address</div>
        <div class="mb-2"><strong>Beskrivelse</strong><br /><div class="text-prewrap">@h.Description</div></div>
        <div class="mb-2"><strong>Faciliteter</strong><br /><div class="text-prewrap">@h.Facilities</div></div>
    </div>
</div>
