@model Sommerhus.Mvc.Controllers.HomeController.HomeIndexVM
@{
    ViewData["Title"] = "Forside";
}

<style>
    .hero {
        text-align: center;
        padding: 18px 10px 8px;
    }

        .hero h4 {
            margin-bottom: .35rem;
        }

    .leadline {
        color: #6c757d;
        margin-bottom: .5rem;
    }

    .search-wrap {
        background: #f8f9fa;
        border-radius: .75rem;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .filter .btn {
        border-radius: .6rem;
    }

    .house-card {
        background: #fff;
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .8rem;
        padding: .75rem;
        height: 100%;
    }

    .house-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
    }

    .house-left {
        flex: 1 1 auto;
    }

    .house-right {
        flex: 0 0 auto;
    }

    .pill {
        border-radius: 999px;
        padding: .25rem .6rem;
        background: #f1f3f5;
        font-size: .85rem;
        white-space: nowrap;
    }

    .btn-read {
        margin: .25rem 0 .5rem;
    }

    .main-img img {
        width: 100%;
        height: 300px;
        object-fit: cover;
        border-radius: .6rem;
        border: 1px solid rgba(0,0,0,.06);
        display: block;
    }

    .thumbs {
        display: flex;
        gap: .5rem;
        margin-top: .5rem;
        overflow: auto;
    }

        .thumbs img {
            height: 70px;
            width: 100px;
            object-fit: cover;
            border-radius: .4rem;
            border: 1px solid rgba(0,0,0,.08);
            display: block;
        }
</style>

<div class="hero">
    <h4>Sommerhusudlejning – Enkelt og sikkert</h4>
    <div class="leadline">
        Vores udgangspunkt er, at det skal være nemt at finde det helt rigtige sommerhus – og nemt at booke.
        Har du spørgsmål, hjælper vi altid på mail og telefon.
    </div>
</div>

<div class="search-wrap">
    <form method="get" action="/" class="row g-2 align-items-center">
        <div class="col-md-6">
            <input class="form-control" name="q" placeholder="Søg efter titel, by, postnr…" value="@Model.Q" />
        </div>
        <div class="col-md-3">
            <input class="form-control" name="city" placeholder="By/slug (fx ho, blavand)" value="@Model.SelectedCitySlug" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-dark w-100">Søg</button>
        </div>
    </form>
    <div class="filter mt-2 d-flex flex-wrap gap-2">
        <a class="btn @(string.IsNullOrEmpty(Model.SelectedCitySlug) ? "btn-dark" : "btn-outline-dark")" href="/">Alle</a>
        @foreach (var c in Model.Cities)
        {
            var active = string.Equals(Model.SelectedCitySlug, c.Slug, StringComparison.OrdinalIgnoreCase);
            <a class="btn @(active ? "btn-dark" : "btn-outline-dark")" href="/?city=@c.Slug">@c.City (@c.Count)</a>
        }
    </div>
    <div class="mt-2">
        <a href="/areas" class="link-dark">Gå til områdesøgning →</a>
    </div>
</div>

<div class="container px-0">
    <div class="row g-4">
        @foreach (var h in Model.Houses)
        {
            <div class="col-12 col-lg-6">
                <div class="house-card">
                    <div class="house-head">
                        <div class="house-left">
                            <strong>@(string.IsNullOrWhiteSpace(h.Subtitle) ? h.Title : h.Subtitle)</strong>
                            <div>
                                <a class="btn btn-sm btn-dark btn-read" href="/houses/@h.Id">Læs mere</a>
                            </div>
                        </div>
                        <div class="house-right">
                            @if (!string.IsNullOrWhiteSpace(h.Zip) || !string.IsNullOrWhiteSpace(h.City))
                            {
                                <span class="pill">@($"{h.Zip} {h.City}".Trim())</span>
                            }
                        </div>
                    </div>

                    <div class="main-img">
                        <a href="/houses/@h.Id">
                            <img src="@(string.IsNullOrWhiteSpace(h.Cover) ? "/images/houses/placeholder.jpg" : h.Cover)" alt="@h.Title" />
                        </a>
                    </div>

                    @if (h.Thumbs.Count > 0)
                    {
                        <div class="thumbs">
                            @foreach (var t in h.Thumbs.Take(6))
                            {
                                <a href="/houses/@h.Id"><img src="@t" alt="Galleri" /></a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
