
@{
    ViewData["Title"] = "kontakt";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grid and Flexbox Layout Website with Slideshow</title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <div class="separator"> </div>
    <form class="form-container" action="#" method="post">
        <h3>send os dit fulde navn</h3>

        <input type="text" id="name" name="name" placeholder="Fulde navn">
        <input type="email" id="email" name="email" placeholder="Email">
        <input type="text" id="phone" name="phone" placeholder="Telefon">
        <textarea id="message" name="message" rows="4" placeholder="Din besked"></textarea>

        <button type="submit" class="submit-button">Send email</button>
    </form>
    <div class="sep-buttom"> </div>
</body>
</html>