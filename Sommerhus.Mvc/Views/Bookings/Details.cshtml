@model BookingDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@{
    ViewData["Title"] = L["Bookings.DetailsTitle", Model.HouseTitle].Value;
    var canCancel = Model.Status is Sommerhus.Domain.Models.BookingStatus.Pending or Sommerhus.Domain.Models.BookingStatus.Confirmed;
    // Serialised so an apostrophe in the text cannot end the JavaScript string.
    var cancelConfirm = System.Text.Json.JsonSerializer.Serialize(L["Bookings.CancelConfirm"].Value);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@L["Bookings.DetailsHeading"]</h1>
    <a href="/bookings" class="btn btn-outline-dark btn-sm">@L["Bookings.BackToBookings"]</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show">@success <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Shared.Close"]"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show">@error <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Shared.Close"]"></button></div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">
                    <a href="/houses/@Model.HouseId" class="text-decoration-none">@Model.HouseTitle</a>
                </h2>
                @if (!string.IsNullOrWhiteSpace(Model.HouseAddress))
                {
                    <p class="text-muted mb-3">@Model.HouseAddress</p>
                }

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="border rounded p-3">
                            <small class="text-muted d-block">@L["Bookings.CheckIn"]</small>
                            <strong>@Model.CheckIn.ToString("d MMMM yyyy")</strong>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="border rounded p-3">
                            <small class="text-muted d-block">@L["Bookings.CheckOut"]</small>
                            <strong>@Model.CheckOut.ToString("d MMMM yyyy")</strong>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="border rounded p-3">
                            <small class="text-muted d-block">@L["Houses.Details.Guests"]</small>
                            <strong>@Model.Guests</strong>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="border rounded p-3">
                            <small class="text-muted d-block">@L["Houses.Details.Nights"]</small>
                            <strong>@(Model.CheckOut.DayNumber - Model.CheckIn.DayNumber)</strong>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="border rounded p-3">
                            <small class="text-muted d-block">@L["Bookings.TotalPrice"]</small>
                            <strong>@Model.TotalPrice.ToString("N0") @Model.Currency</strong>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.GuestNote))
                {
                    <div class="mt-3">
                        <small class="text-muted d-block">@L["Bookings.YourNote"]</small>
                        <p class="mb-0">@Model.GuestNote</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="h6 mb-3">@L["Bookings.Status"]</h3>
                @{
                    var statusClass = Model.Status switch
                    {
                        Sommerhus.Domain.Models.BookingStatus.Pending => "bg-warning text-dark",
                        Sommerhus.Domain.Models.BookingStatus.Confirmed => "bg-success",
                        Sommerhus.Domain.Models.BookingStatus.Completed => "bg-info",
                        Sommerhus.Domain.Models.BookingStatus.Cancelled => "bg-danger",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @statusClass fs-6">@L.Label(Model.Status)</span>

                <hr />

                <dl class="mb-0">
                    <dt class="small text-muted">@L["Bookings.CreatedAt"]</dt>
                    <dd>@Model.CreatedAtUtc.ToString("d MMM yyyy HH:mm")</dd>

                    @if (Model.ConfirmedAtUtc.HasValue)
                    {
                        <dt class="small text-muted">@L["Bookings.ConfirmedAt"]</dt>
                        <dd>@Model.ConfirmedAtUtc.Value.ToString("d MMM yyyy HH:mm")</dd>
                    }

                    @if (Model.CancelledAtUtc.HasValue)
                    {
                        <dt class="small text-muted">@L["Bookings.CancelledAt"]</dt>
                        <dd>@Model.CancelledAtUtc.Value.ToString("d MMM yyyy HH:mm")</dd>
                    }
                </dl>

                @if (canCancel)
                {
                    <hr />
                    <form method="post" action="/bookings/@Model.Id/cancel"
                          onsubmit="return confirm(@cancelConfirm);">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100">@L["Bookings.CancelButton"]</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
