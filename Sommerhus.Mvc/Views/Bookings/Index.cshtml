@model IReadOnlyList<BookingListItemDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@{
    ViewData["Title"] = "My Bookings";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var upcoming = Model.Where(b => b.CheckOut >= today && b.Status is Sommerhus.Domain.Models.BookingStatus.Pending or Sommerhus.Domain.Models.BookingStatus.Confirmed).OrderBy(b => b.CheckIn).ToList();
    var past = Model.Where(b => b.CheckOut < today || b.Status is Sommerhus.Domain.Models.BookingStatus.Completed or Sommerhus.Domain.Models.BookingStatus.Cancelled).OrderByDescending(b => b.CheckIn).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">My Bookings</h1>
    <a href="/account/dashboard" class="btn btn-outline-dark btn-sm">Back to Dashboard</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show">@success <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Shared.Close"]"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show">@error <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Shared.Close"]"></button></div>
}

@if (upcoming.Any())
{
    <h2 class="h5 mb-3">Upcoming</h2>
    <div class="table-responsive mb-4">
        <table class="table table-hover shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>House</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Guests</th>
                    <th>Status</th>
                    <th>Price</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in upcoming)
                {
                    <tr>
                        <td><a href="/houses/@b.HouseId">@b.HouseTitle</a></td>
                        <td>@b.CheckIn.ToString("d MMM yyyy")</td>
                        <td>@b.CheckOut.ToString("d MMM yyyy")</td>
                        <td>@b.Guests</td>
                        <td>
                            @{ var sc = b.Status == Sommerhus.Domain.Models.BookingStatus.Confirmed ? "bg-success" : "bg-warning text-dark"; }
                            <span class="badge @sc">@b.Status</span>
                        </td>
                        <td>@b.TotalPrice.ToString("N0") @b.Currency</td>
                        <td><a href="/bookings/@b.Id" class="btn btn-outline-dark btn-sm">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (past.Any())
{
    <h2 class="h5 mb-3">History</h2>
    <div class="table-responsive">
        <table class="table table-hover shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>House</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Status</th>
                    <th>Price</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in past)
                {
                    <tr>
                        <td><a href="/houses/@b.HouseId">@b.HouseTitle</a></td>
                        <td>@b.CheckIn.ToString("d MMM yyyy")</td>
                        <td>@b.CheckOut.ToString("d MMM yyyy")</td>
                        <td>
                            @{
                                var hc = b.Status switch
                                {
                                    Sommerhus.Domain.Models.BookingStatus.Completed => "bg-info",
                                    Sommerhus.Domain.Models.BookingStatus.Cancelled => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @hc">@b.Status</span>
                        </td>
                        <td>@b.TotalPrice.ToString("N0") @b.Currency</td>
                        <td><a href="/bookings/@b.Id" class="btn btn-outline-dark btn-sm">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <p class="mb-2">You have no bookings yet.</p>
        <a href="/houses" class="btn btn-dark">Browse Houses</a>
    </div>
}
