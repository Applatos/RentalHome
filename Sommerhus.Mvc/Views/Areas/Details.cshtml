@using Sommerhus.Core.Dtos.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@model AreaDetailsDto
@{
    ViewData["Title"] = Model.Name;
}

<section class="py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h2 mb-1">@Model.Name</h1>
            <p class="text-muted mb-0">@L["Areas.Details.Subtitle"]</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["Areas.Details.BackToList"]</a>
    </div>

    @await Html.PartialAsync("~/Views/Shared/_FlashMessages.cshtml")

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="mb-4 lead">@Html.Raw(Model.Description)</div>
    }
    else
    {
        <p class="text-muted">@L["Areas.Details.NoDescription"]</p>
    }

    @if (Model.Images?.Count > 0)
    {
        <section class="mb-4">
            <h2 class="h4">@L["Areas.Details.ImagesHeading"]</h2>
            <div class="row row-cols-1 row-cols-md-3 g-3">
                @foreach (var image in Model.Images)
                {
                    <div class="col">
                        <div class="ratio ratio-4x3 bg-light rounded overflow-hidden">
                            <img src="@image.Url" alt="@(!string.IsNullOrWhiteSpace(image.Alt) ? image.Alt : Model.Name)" class="w-100 h-100" style="object-fit: cover;" />
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <section>
        <h2 class="h4">@L["Areas.Details.HousesInArea", Model.Name]</h2>
        @if (Model.Houses?.Count > 0)
        {
            <ul class="list-group list-group-flush">
                @foreach (var house in Model.Houses)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@house.Title</span>
                        <a class="btn btn-sm btn-outline-dark" asp-controller="Houses" asp-action="Details" asp-route-id="@house.Id">@L["Areas.Details.ViewHouse"]</a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">@L["Areas.Details.NoHouses"]</p>
        }
    </section>
</section>
