@using PubAreas = Sommerhus.Contracts.Dtos.Public.Areas
@model PubAreas.AreaDetailsDto
@{
    ViewData["Title"] = Model.Name;
}
<section class="container my-3">
    <h2>@Model.Name</h2>
    <div class="mb-3">@Html.Raw(Model.Description)</div>

    @if (Model.Images?.Any() == true)
    {
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var img in Model.Images)
            {
                <div class="col">
                    <img src="@img.Url" class="img-fluid rounded" alt="@img.Alt" />
                </div>
            }
        </div>
    }
</section>
