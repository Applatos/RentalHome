@model Sommerhus.Mvc.Services.AreaDetails
@{
    ViewData["Title"] = Model.Name;
}

<style>
    .area-hero {
        background: #f8f9fa;
        border-radius: .75rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .area-hero h2 {
        margin-bottom: .5rem;
    }
    .area-gallery img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: .5rem;
        border: 1px solid rgba(0,0,0,.08);
    }
    .area-houses .card {
        border-radius: .75rem;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.08);
    }
    .area-houses .card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }
</style>

<div class="area-hero">
    <h2 class="mb-1">@Model.Name</h2>
    @if (!string.IsNullOrWhiteSpace(Model.City))
    {
        <div class="text-muted mb-2">@Model.City</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="area-description">
            @foreach (var paragraph in Model.Description!.Split(new[] {"\r\n", "\n"}, StringSplitOptions.RemoveEmptyEntries))
            {
                <p>@paragraph</p>
            }
        </div>
    }
</div>

@if (Model.Images?.Length > 0)
{
    <div class="row g-3 area-gallery mb-4">
        @foreach (var image in Model.Images)
        {
            <div class="col-sm-6 col-lg-3">
                <img src="@image.Url" alt="@Model.Name" />
            </div>
        }
    </div>
}

@if (Model.Houses?.Length > 0)
{
    <h4 class="mb-3">Sommerhuse i området</h4>
    <div class="row g-4 area-houses">
        @foreach (var house in Model.Houses)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(house.CoverUrl))
                    {
                        <a href="/houses/@house.Id"><img src="@house.CoverUrl" class="card-img-top" alt="@house.Title" /></a>
                    }
                    <div class="card-body">
                        <h6 class="card-title">@house.Title</h6>
                        @if (!string.IsNullOrWhiteSpace(house.Subtitle))
                        {
                            <div class="text-muted mb-2">@house.Subtitle</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(house.Zip) || !string.IsNullOrWhiteSpace(house.City))
                        {
                            <div class="mb-3"><span class="badge bg-light text-dark">@($"{house.Zip} {house.City}".Trim())</span></div>
                        }
                        <a class="btn btn-outline-dark btn-sm" href="/houses/@house.Id">Se detaljer</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">Der er endnu ikke tilknyttet sommerhuse til dette område.</div>
}
