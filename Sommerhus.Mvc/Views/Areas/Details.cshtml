@using Sommerhus.Mvc.Infrastructure
@using Sommerhus.Mvc.ViewModels.Public.Areas
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@model AreaPageVm
@{
    var area = Model.Area;
    ViewData["Title"] = area.Name;

    // The first image is the area's cover; the rest form the strip below.
    var images = area.Images ?? [];
    var cover = images.FirstOrDefault();
    var strip = images.Skip(1).ToList();
    var cities = string.Join(", ", (area.Cities ?? []).Select(c => c.Label.Replace(" – ", " ")));
    var houseCount = Model.Houses.Count == 1
        ? $"1 {L["Areas.List.HouseSingular"]}"
        : $"{Model.Houses.Count} {L["Areas.List.HousePlural"]}";
    var meta = string.Join(" · ", new[] { cities, houseCount }.Where(p => !string.IsNullOrWhiteSpace(p)));
}

<nav class="breadcrumbs" aria-label="@L["Shared.Breadcrumbs"]">
    <ol>
        <li><a href="/areas">@L["Areas.List.Title"]</a></li>
        <li aria-current="page">@area.Name</li>
    </ol>
</nav>

@await Html.PartialAsync("~/Views/Shared/_FlashMessages.cshtml")

<div class="area-hero @(cover is null ? "area-hero--text-only" : null)">
    <div class="area-hero__text">
        <h1>@area.Name</h1>
        <p class="area-hero__meta">@meta</p>
        @if (!string.IsNullOrWhiteSpace(area.Description))
        {
            @TextParagraphs.Render(area.Description)
        }
        else
        {
            <p class="text-muted">@L["Areas.Details.NoDescription"]</p>
        }
    </div>
    @if (cover is not null)
    {
        <img class="area-hero__cover" src="@cover.Url" alt="@(string.IsNullOrWhiteSpace(cover.Alt) ? area.Name : cover.Alt)" />
    }
</div>

@if (strip.Count > 0)
{
    <ul class="photo-strip">
        @foreach (var image in strip)
        {
            <li><img src="@image.Url" alt="@(string.IsNullOrWhiteSpace(image.Alt) ? area.Name : image.Alt)" loading="lazy" decoding="async" /></li>
        }
    </ul>
}

<section class="area-houses">
    <h2>@L["Areas.Details.HousesInArea", area.Name]</h2>
    @if (Model.Houses.Count > 0)
    {
        <div class="card-grid">
            @foreach (var house in Model.Houses)
            {
                @await Html.PartialAsync("~/Views/Houses/_HouseCard.cshtml", house)
            }
        </div>
    }
    else
    {
        <p class="text-muted">@L["Areas.Details.NoHouses"]</p>
    }
</section>

@section Scripts {
    <script src="~/js/house-carousel.js" asp-append-version="true"></script>
}
