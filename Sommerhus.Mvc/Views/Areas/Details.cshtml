@model Sommerhus.Mvc.Controllers.AreasController.AreaPageVm
@{
    ViewData["Title"] = Model.Title;
}
<style>
    .area-hero {
        background: #f8f9fa;
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
    }

    .imgstrip img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: .5rem;
    }
</style>

<div class="container py-3">
    <div class="area-hero">
        <h3 class="mb-2">@Model.Title</h3>
        <div>@Html.Raw(Model.Html)</div>
    </div>

    @if (Model.Images?.Count > 0)
    {
        <div class="row g-3 imgstrip">
            @foreach (var img in Model.Images)
            {
                <div class="col-sm-6 col-lg-3">
                    <img src="@img" alt="@Model.Title" />
                </div>
            }
        </div>
    }
</div>
