@using Sommerhus.Contracts.Dtos.Public.Areas
@model IReadOnlyList<AreaListItemDto>
@{
    ViewData["Title"] = "Områder";
    var query = (ViewData["Query"] as string) ?? string.Empty;
    var error = TempData["Err"] as string;
}

<section class="py-3">
    <header class="mb-4 text-center">
        <h1 class="h2 mb-2">Områder og oplevelser</h1>
        <p class="text-muted mb-0">Find inspiration og læs mere om de danske områder, hvor vi udlejer sommerhuse.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <form method="get" class="row g-2 justify-content-center mb-4">
        <div class="col-md-5">
            <input class="form-control" name="q" value="@query" placeholder="Søg efter område" />
        </div>
        <div class="col-md-2 col-6">
            <button class="btn btn-dark w-100">Søg</button>
        </div>
        <div class="col-md-2 col-6">
            <a class="btn btn-outline-secondary w-100" asp-action="Index">Nulstil</a>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <p class="text-muted text-center">Der blev ikke fundet nogen områder.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var area in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h4">@area.Name</h2>
                            <p class="text-muted">@area.HouseCount @(area.HouseCount == 1 ? "sommerhus" : "sommerhuse")</p>
                            <div class="mt-auto">
                                <a class="btn btn-outline-dark" asp-action="Details" asp-route-id="@area.Id">Læs mere</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>