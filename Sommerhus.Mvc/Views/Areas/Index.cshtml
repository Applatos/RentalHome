@using Sommerhus.Core.Dtos.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@model IReadOnlyList<AreaListItemDto>
@{
    ViewData["Title"] = L["Areas.List.Title"];
    var query = (ViewData["Query"] as string) ?? string.Empty;
}

<div class="page-heading">
    <h1>@L["Areas.List.Heading"]</h1>
    <p>@L["Areas.List.Subtitle"]</p>
</div>

@await Html.PartialAsync("~/Views/Shared/_FlashMessages.cshtml")

<form method="get" class="search-panel">
    <div class="search-panel__row">
        <div class="search-panel__field search-panel__field--wide">
            <label class="form-label" for="area-q">@L["Shared.Search"]</label>
            <input id="area-q" class="form-control" type="search" name="q" value="@query" placeholder="@L["Areas.List.SearchPlaceholder"]" />
        </div>
        <div class="search-panel__actions">
            <button class="btn btn-primary">@L["Shared.Search"]</button>
            <a class="btn btn-outline-dark" asp-action="Index">@L["Shared.Reset"]</a>
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <p class="text-muted">@L["Areas.List.Empty"]</p>
}
else
{
    <div class="card-grid">
        @foreach (var area in Model)
        {
            var href = $"/areas/{area.Id}";
            <article class="area-card">
                <a class="area-card__media" href="@href" tabindex="-1" aria-hidden="true">
                    @if (!string.IsNullOrWhiteSpace(area.CoverUrl))
                    {
                        <img src="@area.CoverUrl" alt="" loading="lazy" decoding="async" />
                    }
                    else
                    {
                        <span class="area-card__placeholder">
                            <svg width="64" height="40" viewBox="0 0 64 40" fill="none" aria-hidden="true"><path d="M2 30c6 0 6-5 12-5s6 5 12 5 6-5 12-5 6 5 12 5 6-5 12-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /><path d="M10 22c5-9 11-14 18-14s13 5 18 14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
                            <span>@L["Areas.List.PhotosComing"]</span>
                        </span>
                    }
                </a>
                <div class="area-card__body">
                    <div class="area-card__heading">
                        <h2><a href="@href">@area.Name</a></h2>
                        <span>@area.HouseCount @(area.HouseCount == 1 ? L["Areas.List.HouseSingular"] : L["Areas.List.HousePlural"])</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(area.Summary))
                    {
                        <p>@area.Summary</p>
                    }
                    <a class="area-card__link" href="@href">@L["Areas.List.ReadAbout", area.Name] →</a>
                </div>
            </article>
        }
    </div>
}
