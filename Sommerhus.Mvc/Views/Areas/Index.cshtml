@using Sommerhus.Core.Dtos.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@model IReadOnlyList<AreaListItemDto>
@{
    ViewData["Title"] = L["Areas.List.Title"];
    var query = (ViewData["Query"] as string) ?? string.Empty;
}

<section class="py-3">
    <header class="mb-4 text-center">
        <h1 class="h2 mb-2">@L["Areas.List.Heading"]</h1>
        <p class="text-muted mb-0">@L["Areas.List.Subtitle"]</p>
    </header>

    @await Html.PartialAsync("~/Views/Shared/_FlashMessages.cshtml")

    <form method="get" class="row g-2 justify-content-center mb-4">
        <div class="col-md-5">
            <input class="form-control" name="q" value="@query" placeholder="@L["Areas.List.SearchPlaceholder"]" />
        </div>
        <div class="col-md-2 col-6">
            <button class="btn btn-dark w-100">@L["Shared.Search"]</button>
        </div>
        <div class="col-md-2 col-6">
            <a class="btn btn-outline-secondary w-100" asp-action="Index">@L["Shared.Reset"]</a>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <p class="text-muted text-center">@L["Areas.List.Empty"]</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var area in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h4">@area.Name</h2>
                            <p class="text-muted">@area.HouseCount @(area.HouseCount == 1 ? L["Areas.List.HouseSingular"] : L["Areas.List.HousePlural"])</p>
                            <div class="mt-auto">
                                <a class="btn btn-outline-dark" href="areas/@area.Id">@L["Areas.List.ReadMore"]</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
