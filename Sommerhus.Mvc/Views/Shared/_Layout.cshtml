@using Microsoft.AspNetCore.Localization
@using Sommerhus.Core.Identity
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@{
    var title = (ViewData["Title"] as string) ?? L["Site.Brand"];
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "da-DK";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!doctype html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <!-- Bootstrap 5.3 and Bootstrap Icons, served from wwwroot/lib -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-additions.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container container-main">
            <a class="navbar-brand" href="~/houses">@L["Site.Brand"]</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link" href="~/houses">@L["Nav.Home"]</a>
                <a class="nav-link" href="~/areas">@L["Nav.Areas"]</a>
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="nav-link" href="~/admin/houses">@L["Nav.Admin"]</a>
                }
            </div>
            <div class="navbar-nav me-3">
                <form method="post" action="/culture/set" class="d-inline-flex align-items-center gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <label class="text-white-50 small mb-0" for="cultureSelect">@L["Nav.Language"]</label>
                    <select id="cultureSelect"
                            name="culture"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()"
                            aria-label="@L["Nav.Language"]">
                        <option value="da-DK" selected="@(currentCulture == "da-DK")">Dansk</option>
                        <option value="en-GB" selected="@(currentCulture == "en-GB")">English</option>
                    </select>
                </form>
            </div>
            <div class="navbar-nav ms-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" href="/account/dashboard">@L["Nav.Dashboard"]</a>
                    <a class="nav-link" href="/bookings">@L["Nav.Bookings"]</a>
                    @if (User.IsInRole("HouseOwner") || User.IsInRole("Admin"))
                    {
                        <a class="nav-link" href="/owner/dashboard">@L["Nav.Owner"]</a>
                    }
                    <span class="navbar-text me-2">@User.Identity?.Name</span>
                    <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm">@L["Nav.Logout"]</button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">@L["Nav.Login"]</a>
                }
            </div>
        </div>
    </nav>

    <div class="container container-main py-3">
        @RenderBody()
    </div>

    <!-- Bootstrap JS bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    <script>
        if (!window.htmx) {
            const fallback = document.createElement('script');
            fallback.src = 'https://unpkg.com/htmx.org@1.9.12';
            fallback.integrity = 'sha384-b+aQGCXE32Yb7qteEmKIgmpG/5KO8i898gH91tPdOc2LSs2miPK29QXny+Ysg6XE';
            fallback.crossOrigin = 'anonymous';
            fallback.defer = true;
            document.head.appendChild(fallback);
        }
    </script>
    <script>
        document.body.addEventListener('htmx:configRequest', (evt) => {
            const t = document.querySelector('input[name="__RequestVerificationToken"]');
            if (t) evt.detail.headers['RequestVerificationToken'] = t.value;
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

