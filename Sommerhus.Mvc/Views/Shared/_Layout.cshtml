@{
    var title = (ViewData["Title"] as string) ?? "Sommerhuse";
}
<!doctype html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <!-- Bootstrap CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body { background:#f5f5f5; }
        .container-main { max-width: 1100px; }

        /* --- Cards på forsiden --- */
        .house-card { background:#fff; border-radius:.5rem; }
        .house-card .card-body { padding:1rem 1rem 1.25rem; }

        /* Wrapper rundt om billedet der bestemmer HØJDEN.
           aspect-ratio sørger for at layoutet reserverer pladsen,
           så billedet ikke "skubber" efterfølgende elementer rundt.
           overflow:hidden + border-radius for at holde billedet inde i rammen. */
        .house-card .cover-wrap{
            position:relative;
            width:100%;
            aspect-ratio: 16/9;     /* stabil højde – justér fx til 4/3 hvis du vil */
            overflow:hidden;
            border-radius:.5rem;
            background:#e9ecef;     /* lys baggrund mens billedet loader */
        }

        /* Selve img fylder hele wrapperen, men beskæres pænt (cover). */
        .house-card .cover-wrap img{
            width:100%;
            height:100%;
            object-fit:cover;
            display:block;          /* fjerner default inline-gap */
        }

        /* Overlay til badges placeres INDE i wrapperen
           (position:absolute + z-index), så de aldrig flyder ud over andre kort. */
        .house-card .cover-overlay{
            position:absolute;
            top:.5rem; left:.5rem; right:.5rem;
            display:flex; gap:.25rem; flex-wrap:wrap;
            z-index:2;
        }
        .house-card .cover-overlay .badge{
            background:#f8f9fa; color:#212529; border:1px solid #dee2e6;
        }

        /* Læs-mere knappen placeres i header-række, ikke oven på billedet. */
        .house-card .header-row { display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem; }

        /* Små visuelle justeringer */
        .muted { color:#6c757d; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container container-main">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Sommerhuse</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Forside</a>
                <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a>
            </div>
        </div>
    </nav>

    <div class="container container-main py-3">
        @RenderBody()
    </div>

    <!-- Bootstrap JS bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script>
        // Send anti-forgery token med HTMX-requests
        document.body.addEventListener('htmx:configRequest', (evt) => {
        const t = document.querySelector('input[name="__RequestVerificationToken"]');
        if (t) evt.detail.headers['RequestVerificationToken'] = t.value;
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
