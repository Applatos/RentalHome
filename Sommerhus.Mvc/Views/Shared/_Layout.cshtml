@using Microsoft.AspNetCore.Localization
@using Sommerhus.Core.Identity
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@{
    // A view may set its title as a string or as a LocalizedString; both print their text.
    var brand = L["Site.Brand"].Value;
    var pageTitle = ViewData["Title"]?.ToString();
    var title = string.IsNullOrWhiteSpace(pageTitle) || pageTitle == brand ? brand : $"{pageTitle} · {brand}";
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "da-DK";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var path = Context.Request.Path.Value ?? "/";
    string? Current(bool active) => active ? "page" : null;
    var onAreas = path.StartsWith("/areas", StringComparison.OrdinalIgnoreCase);
    var onAdmin = path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase);
    var onHouses = !onAreas && !onAdmin && (path == "/" || path.StartsWith("/houses", StringComparison.OrdinalIgnoreCase));
}
<!doctype html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <!-- Bootstrap 5.3, Bootstrap Icons and the site font, all served from wwwroot/lib -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="preload" href="~/lib/schibsted-grotesk/schibsted-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="site-container site-header__inner">
            <a class="brand" href="~/houses">
                <svg class="brand__mark" width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 15 16 6l11 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /><path d="M4 24c3 0 3-2 6-2s3 2 6 2 3-2 6-2 3 2 6 2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
                <span class="brand__name">@brand</span>
                <span class="brand__tagline">@L["Site.Tagline"]</span>
            </a>
            <nav class="site-nav" aria-label="@L["Nav.Main"]">
                <a class="site-nav__link" href="~/houses" aria-current="@Current(onHouses)">@L["Nav.Houses"]</a>
                <a class="site-nav__link" href="~/areas" aria-current="@Current(onAreas)">@L["Nav.Areas"]</a>
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="site-nav__link" href="~/admin/houses" aria-current="@Current(onAdmin)">@L["Nav.Admin"]</a>
                }
            </nav>
            <div class="site-header__tools">
                <form method="post" action="/culture/set" class="d-inline-flex align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <label class="visually-hidden-label" for="cultureSelect">@L["Nav.Language"]</label>
                    <select id="cultureSelect"
                            name="culture"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">
                        <option value="da-DK" selected="@(currentCulture == "da-DK")">Dansk</option>
                        <option value="en-GB" selected="@(currentCulture == "en-GB")">English</option>
                    </select>
                </form>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/account/dashboard">@L["Nav.Dashboard"]</a>
                    <a href="/bookings">@L["Nav.Bookings"]</a>
                    @if (User.IsInRole(AppRoles.HouseOwner) || User.IsInRole(AppRoles.Admin))
                    {
                        <a href="/owner/dashboard">@L["Nav.Owner"]</a>
                    }
                    <span class="site-header__user">@User.Identity?.Name</span>
                    <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-dark btn-sm">@L["Nav.Logout"]</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-dark btn-sm" asp-controller="Account" asp-action="Login">@L["Nav.Login"]</a>
                }
            </div>
        </div>
    </header>

    <main class="site-main">
        <div class="site-container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="site-container site-footer__inner">
            <span class="brand">
                <svg class="brand__mark" width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 15 16 6l11 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /><path d="M4 24c3 0 3-2 6-2s3 2 6 2 3-2 6-2 3 2 6 2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
                <span class="brand__name">@brand</span>
            </span>
            <span>@L["Footer.PricesIncludeVat"]</span>
        </div>
    </footer>

    <!-- Bootstrap JS bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    <script>
        if (!window.htmx) {
            const fallback = document.createElement('script');
            fallback.src = 'https://unpkg.com/htmx.org@1.9.12';
            fallback.integrity = 'sha384-b+aQGCXE32Yb7qteEmKIgmpG/5KO8i898gH91tPdOc2LSs2miPK29QXny+Ysg6XE';
            fallback.crossOrigin = 'anonymous';
            fallback.defer = true;
            document.head.appendChild(fallback);
        }
    </script>
    <script>
        document.body.addEventListener('htmx:configRequest', (evt) => {
            const t = document.querySelector('input[name="__RequestVerificationToken"]');
            if (t) evt.detail.headers['RequestVerificationToken'] = t.value;
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
