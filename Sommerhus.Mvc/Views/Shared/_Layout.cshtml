@{
    var title = (ViewData["Title"] as string) ?? "Sommerhuse";
}
<!doctype html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-additions.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container container-main">
            <a class="navbar-brand" asp-controller="Houses" asp-action="Index">Sommerhuse</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link" asp-controller="Houses" asp-action="Index">Forside</a>
                <a class="nav-link" asp-controller="Areas" asp-action="Index">Områder</a>
                <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a>
            </div>
            <div class="navbar-nav ms-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="navbar-text me-2">@User.Identity?.Name</span>
                    <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm">Log ud</button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Log ind</a>
                }
            </div>
        </div>
    </nav>

    <div class="container container-main py-3">
        @RenderBody()
    </div>

    <!-- Bootstrap JS bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    <script>
        if (!window.htmx) {
            const fallback = document.createElement('script');
            fallback.src = 'https://unpkg.com/htmx.org@1.9.12';
            fallback.integrity = 'sha384-b+aQGCXE32Yb7qteEmKIgmpG/5KO8i898gH91tPdOc2LSs2miPK29QXny+Ysg6XE';
            fallback.crossOrigin = 'anonymous';
            fallback.defer = true;
            document.head.appendChild(fallback);
        }
    </script>
    <script>
        document.body.addEventListener('htmx:configRequest', (evt) => {
            const t = document.querySelector('input[name="__RequestVerificationToken"]');
            if (t) evt.detail.headers['RequestVerificationToken'] = t.value;
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

