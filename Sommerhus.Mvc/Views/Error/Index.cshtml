@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@{
    var statusCode = (int)(ViewData["StatusCode"] ?? 500);
    ViewData["Title"] = statusCode == 404 ? L["Error.NotFoundTitle"].Value : L["Error.GenericTitle"].Value;
}

<section class="py-5 text-center">
    <h1 class="display-4 text-muted">@statusCode</h1>

    @if (statusCode == 404)
    {
        <p class="lead">@L["Error.NotFoundMessage"]</p>
    }
    else
    {
        <p class="lead">@L["Error.GenericMessage"]</p>
    }

    <a class="btn btn-dark mt-3" href="/">@L["Error.BackToHome"]</a>
</section>
