@using System.Globalization
@using System.Linq
@using Sommerhus.Core.Dtos.Shared
@using Sommerhus.Core.Dtos.Shared
@model PublicHouseDetailsDto

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.City)
        ? Model.Title
        : $"{Model.City} – {Model.Title}";

    var images = (Model.Images ?? Array.Empty<ImageDto>()).ToList();

    // Adskil plantegninger
    var floorplans = images.Where(i => string.Equals(i.Kind, "floorplan", StringComparison.OrdinalIgnoreCase)).ToList();
    var galleryAll = images.Where(i => !string.Equals(i.Kind, "floorplan", StringComparison.OrdinalIgnoreCase)).ToList();

    // Cover (til højre kolonne)
    var cover = galleryAll.FirstOrDefault(i => string.Equals(i.Kind, "cover", StringComparison.OrdinalIgnoreCase))
               ?? galleryAll.FirstOrDefault();

    // Slides (venstre kolonne): alle galleri-billeder minus cover
    var slides = galleryAll;
    if (!slides.Any() && cover is not null)
    {
        // Fallback: hvis kun ét billede findes, brug det også i venstre, så der vises noget
        slides = new List<ImageDto> { cover };
    }

    var today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
    var defaultArrival = today.AddDays(7);
    var defaultDeparture = defaultArrival.AddDays(7);
    var todayValue = today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var arrivalValue = defaultArrival.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var departureValue = defaultDeparture.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}

<section class="container my-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">@Model.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Address) || !string.IsNullOrWhiteSpace(Model.Zip) || !string.IsNullOrWhiteSpace(Model.City))
            {
                <p class="text-body-secondary mb-0">
                    @Model.Address
                    @if (!string.IsNullOrWhiteSpace(Model.Address) && (!string.IsNullOrWhiteSpace(Model.Zip) || !string.IsNullOrWhiteSpace(Model.City)))
                    {
                        <span>, </span>
                    }
                    @Model.Zip @Model.City
                </p>
            }
        </div>
        <a class="btn btn-primary" href="#booking-card">Book</a>
    </div>

    <!-- TOP: 2 kolonner med billeder -->
    <div class="row g-3 mb-3">
        <!-- Venstre: Carousel uden thumbnails -->
        <div class="col-lg-8">
            @if (slides.Any())
            {
                <div id="houseCarousel" class="carousel slide" data-bs-ride="false">
                    <div class="carousel-inner rounded-3 overflow-hidden">
                        @for (var i = 0; i < slides.Count; i++)
                        {
                            var img = slides[i];
                            <div class="carousel-item @(i == 0 ? "active" : null)">
                                <div class="ratio ratio-16x9">
                                    <img src="@img.Url" alt="@img.Alt" class="d-block w-100" style="object-fit:cover;" loading="@(i == 0 ? "eager" : "lazy")" />
                                </div>
                            </div>
                        }
                    </div>

                    @if (slides.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#houseCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Forrige</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#houseCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Næste</span>
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Højre: kun cover-billedet -->
        <div class="col-lg-4">
            @if (cover is not null)
            {
                <div class="ratio ratio-4x3 rounded-3 overflow-hidden">
                    <img src="@cover.Url" alt="@cover.Alt" class="w-100 h-100" style="object-fit:cover;" loading="lazy" />
                </div>
            }
        </div>
    </div>

    <!-- MIDT: Feature-ikoner som vandret bælte -->
    @if (Model.Features?.Any() == true)
    {
        <div class="border-top border-bottom py-3 my-3">
            <div class="d-flex gap-3">
                @foreach (var f in Model.Features)
                {
                    <div class="flex-column">
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrWhiteSpace(f.IconUrl))
                            {
                                <img src="@f.IconUrl" alt="ikon" width="28" height="28" />
                            }
                            <small>@f.Name</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- BUND: 2 kolonner igen -->
    <div class="row g-4">
        <div class="col-lg-7">
            <h2 class="h5">Beskrivelse</h2>
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    @Html.Raw(Model.Description)   @* sanér server-side hvis HTML kommer udefra *@
                }
                else
                {
                    <p class="text-body-secondary">Der er endnu ingen beskrivelse for dette sommerhus.</p>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div id="booking-card" class="card shadow-sm mb-4" data-pricing-root>
                <div class="card-body">
                    <h2 class="h5 mb-3">Beregn pris</h2>
                    <form data-pricing-form
                          data-house-id="@Model.Id"
                          data-area-id=""
                          data-quote-url="@Url.Action("Quote", "Houses", new { id = Model.Id })">
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="arrival" class="form-label">Ankomst</label>
                                <input type="date"
                                       class="form-control"
                                       id="arrival"
                                       name="arrival"
                                       value="@arrivalValue"
                                       min="@todayValue"
                                       data-pricing-arrival />
                            </div>
                            <div class="col-6">
                                <label for="departure" class="form-label">Afrejse</label>
                                <input type="date"
                                       class="form-control"
                                       id="departure"
                                       name="departure"
                                       value="@departureValue"
                                       min="@arrivalValue"
                                       data-pricing-departure />
                            </div>
                        </div>
                        <div class="mt-3">
                            <label for="guests" class="form-label">Gæster</label>
                            <input type="number"
                                   class="form-control"
                                   id="guests"
                                   name="guests"
                                   min="1"
                                   max="20"
                                   value="4"
                                   data-pricing-guests />
                        </div>
                    </form>
                    <div class="mt-3 small text-body-secondary" data-pricing-empty>
                        Vælg ankomst og afrejse for at se prisen.
                    </div>
                    <div class="mt-3 d-none" data-pricing-loading>
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                            <span>Henter pris...</span>
                        </div>
                    </div>
                    <div class="mt-3 alert alert-warning d-none" role="alert" data-pricing-error></div>
                    <div class="mt-3 d-none" data-pricing-summary>
                        <p class="mb-2 small text-body-secondary">Nætter: <span data-pricing-nights></span></p>
                        <ul class="list-unstyled mb-2 small" data-pricing-breakdown></ul>
                        <div class="d-flex justify-content-between mb-1 small text-body-secondary">
                            <span>Subtotal</span>
                            <span data-pricing-subtotal></span>
                        </div>
                        <div class="d-flex justify-content-between mb-1 small text-body-secondary d-none" data-pricing-tax-row>
                            <span>Moms</span>
                            <span data-pricing-tax></span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between">
                            <span class="fw-semibold">Total</span>
                            <span class="fw-semibold" data-pricing-total></span>
                        </div>
                        <p class="mt-2 mb-0 small text-body-secondary">Prisen er vejledende og kan justeres ved endelig booking.</p>
                    </div>
                </div>
            </div>

            <h2 class="h5">Faciliteter</h2>
            @if (Model.Features?.Any() == true)
            {
                <div class="row row-cols-2 g-2 mb-3">
                    @foreach (var f in Model.Features)
                    {
                        <div class="col">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(f.IconUrl))
                                {
                                    <img src="@f.IconUrl" alt="" width="20" height="20" loading="lazy" />
                                }
                                <span class="small">@f.Name</span>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (floorplans.Any())
            {
                <h3 class="h6">Plantegning</h3>
                <div class="row g-2">
                    @foreach (var fp in floorplans)
                    {
                        <div class="col-12">
                            <div class="ratio ratio-4x3 bg-white rounded-3">
                                <img src="@fp.Url" alt="@fp.Alt" class="w-100 h-100" style="object-fit:contain;" loading="lazy" />
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/house-pricing.js" asp-append-version="true"></script>
}
