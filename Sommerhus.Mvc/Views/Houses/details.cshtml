@using PubHouses = Sommerhus.Contracts.Dtos.Public.Houses
@using Sommerhus.Mvc.Utils
@model PubHouses.HouseDetailsDto
@{
    ViewData["Title"] = $"{Model.City} - {Model.Title}";
}
<section class="container my-3">
    <div class="d-flex justify-content-between align-items-center">
        <h2>@Model.City - @Model.Title</h2>
        <a class="btn btn-dark">Book her! ▸</a>
    </div>

    <div class="row g-4 my-2">
        <div class="col-md-8">
            @if (!string.IsNullOrWhiteSpace(Model.CoverUrl))
            {
                <img src="@Model.CoverUrl" class="img-fluid rounded w-100" alt="cover" />
            }
        </div>
        <div class="col-md-4">
            @if (Model.Gallery?.Any() == true)
            {
                <div class="d-grid gap-2">
                    @foreach (var img in Model.Gallery.WithoutCover())
                    {
                        <img src="@img.Url" class="img-fluid rounded" alt="@img.Alt" />
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.Features?.Any() == true)
    {
        <div class="my-3 border-top pt-3 d-flex flex-wrap gap-3">
            @foreach (var f in Model.Features.DistinctFeatures())
            {
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(f.IconUrl))
                    {
                        <img src="@f.IconUrl" width="28" height="28" alt="@f.Name" />
                    }
                    <small>@f.Display</small>
                </div>
            }
        </div>
    }

    <div class="row g-4 mt-2">
        <div class="col-md-8">
            <h4>Beskrivelse</h4>
            <div>@Html.Raw(Model.Description)</div>
        </div>
        <div class="col-md-4">
            <h4>Faciliteter</h4>
            <div>@Html.Raw(Model.Facilities)</div>
            @if (Model.Floorplan is not null)
            {
                <div class="mt-3">
                    <img src="@Model.Floorplan.Url" class="img-fluid rounded" alt="@Model.Floorplan.Alt" />
                </div>
            }
        </div>
    </div>
</section>
