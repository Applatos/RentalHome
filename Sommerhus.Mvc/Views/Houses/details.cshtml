@using Sommerhus.Contracts.Dtos.Public.Houses
@using Sommerhus.Mvc.Utils
@model HouseDetailsDto
@{
    ViewData["Title"] = $"{Model.City} - {Model.Title}";
}
<section class="container my-3">
    <div class="d-flex justify-content-between align-items-center">
        <h2>@Model.City - @Model.Title</h2>
        <a class="btn btn-dark">Book her! ▸</a>
    </div>

    <div class="row g-4 my-2">
        <div class="col-md-8">
            @{ var coverImg = Model.Images.FirstOrDefault(i => i.Kind == "cover");}
            @if (coverImg != null)
            {
                <img src="@coverImg.Url" class="img-fluid rounded w-100" alt="cover" />
            }
        </div>
        <div class="col-md-4">
            @if (Model.Images.Any() == true)
            {
                <div class="d-grid gap-2">
                    @foreach (var img in Model.Images)
                    {
                        <img src="@img.Url" class="img-fluid rounded" alt="@img.Alt" />
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.Features?.Any() == true)
    {
        <div class="my-3 border-top pt-3 d-flex flex-wrap gap-3">
            @foreach (var f in Model.Features)
            {
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(f.IconUrl))
                    {
                        <img src="@f.IconUrl" width="28" height="28" alt="@f.Name" />
                    }
                    <small>@f.Name</small>
                </div>
            }
        </div>
    }

    <div class="row g-4 mt-2">
        <div class="col-md-8">
            <h4>Beskrivelse</h4>
            <div>@Html.Raw(Model.Description)</div>
        </div>
        <div class="col-md-4">
            <h4>Floor plan</h4>
            @{
                var floorplanImgs = Model.Images.Where(i => i.Kind == "floorplan").ToList();
            }
            @if (floorplanImgs.Any())
            {
                <div class="mt-3 d-grid gap-2">
                    @foreach (var img in floorplanImgs)
                    {
                        <img src="@img.Url" class="img-fluid rounded" alt="floorplan" />
                    }
                </div>
            }
        </div>
    </div>
</section>
