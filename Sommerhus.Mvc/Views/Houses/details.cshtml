@model Sommerhus.Mvc.Services.HouseDetails
@{
    ViewData["Title"] = Model.Title;

    // slides: cover + galleri (uden dubletter)
    var slides = new List<(string Url, string Alt)>();
    if (!string.IsNullOrWhiteSpace(Model.CoverUrl)) slides.Add((Model.CoverUrl!, Model.Title ?? "Cover"));
    if (Model.Gallery is not null) foreach (var g in Model.Gallery) if (!string.IsNullOrWhiteSpace(g.Url)) slides.Add((g.Url, g.Alt ?? Model.Title ?? "Billede"));
    slides = slides.GroupBy(s => s.Url).Select(g => g.First()).ToList();

    // Vis kun de features vi har ikoner til
    var allowed = new HashSet<string>(StringComparer.OrdinalIgnoreCase) {
        "beach","groundsize","housesize","panorama","personer","rengøring","sauna","shopping","spa","tv","wifi"
    };

    var featuresToShow = (Model.Features ?? Array.Empty<Sommerhus.Mvc.Services.FeatureValueDto>())
        .Where(f =>
            allowed.Contains(f.Key) &&
            (
                (f.ValueType == "Bool" && f.Bool == true) ||
                (f.ValueType == "Int" && f.Int is not null) ||
                (f.ValueType == "Decimal" && f.Decimal is not null) ||
                (f.ValueType == "Text" && !string.IsNullOrWhiteSpace(f.Text))
            )
        )
        .OrderBy(f => f.Name).ToList();

    string IconPath(string key) => Url.Content($"/images/features/{key}.png"); // matcher din mappe
}

<style>
    .page-wrap {
        padding-top: 12px;
    }

    .meta {
        color: #6c757d;
    }

    .carousel-item img {
        width: 100%;
        height: 420px;
        object-fit: cover;
        display: block;
    }

    .side-cover img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: .5rem;
    }

    .btn-book {
        display: block;
        width: 100%;
        font-weight: 600;
        border-radius: .6rem;
    }

    .iconbar {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        border-top: 1px solid #e6e6e6;
        border-bottom: 1px solid #e6e6e6;
        padding: 10px 0;
        margin: 12px 0 16px;
    }

    .icon-pill {
        text-align: center;
        min-width: 80px;
    }

        .icon-pill .p-ico {
            width: 42px;
            height: 42px;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f5f5f5;
            margin: 0 auto 4px;
            border: 1px solid rgba(0,0,0,.08);
        }

        .icon-pill img {
            max-width: 26px;
            max-height: 26px;
            object-fit: contain;
        }

        .icon-pill .p-txt {
            font-size: .9rem;
            line-height: 1.1;
        }

    .card-lite {
        background: #fff;
        border: 1px solid rgba(0,0,0,.08);
        border-radius: .75rem;
        padding: 1rem;
    }
</style>

<div class="container page-wrap">
    <div class="mb-2">
        <h3 class="mb-0">@Model.Title</h3>
        <div class="meta">@($"{Model.Zip} {Model.City}".Trim())</div>
    </div>

    <div class="row g-3">
        <!-- Venstre kolonne: slider + FEATURES UNDER + beskrivelse -->
        <div class="col-lg-8">
            <div id="houseCarousel" class="carousel slide shadow-sm rounded overflow-hidden mb-3" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @if (slides.Count == 0)
                    {
                        <div class="carousel-item active">
                            <div class="d-flex align-items-center justify-content-center" style="height:420px;color:#999;background:#f8f9fa">
                                Ingen billeder endnu
                            </div>
                        </div>
                    }
                    else
                    {
                        var idx = 0;
                        foreach (var s in slides)
                        {
                            <div class="carousel-item @(idx == 0 ? "active" : "")">
                                <img src="@s.Url" alt="@s.Alt" />
                            </div>
                            idx++;
                        }
                    }
                </div>
                @if (slides.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#houseCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Forrige</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#houseCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Næste</span>
                    </button>
                }
            </div>

            <!-- FEATURES: under slideren i venstre kolonne -->
            <div class="iconbar">
                @if (featuresToShow.Count == 0)
                {
                    <span class="text-muted">Ingen features angivet endnu.</span>
                }
                else
                {
                    foreach (var f in featuresToShow)
                    {
                        var icon = IconPath(f.Key);
                        <div class="icon-pill">
                            <div class="p-ico">
                                <img src="@icon" alt="@f.Name"
                                     onerror="this.style.display='none';" />
                            </div>
                            <div class="p-txt">
                                <div>@f.Name</div>
                                @if (!string.IsNullOrWhiteSpace(f.Display))
                                {
                                    <div class="text-muted small">@f.Display</div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <h5 class="mb-2">Beskrivelse</h5>
            <div class="card-lite">
                <p class="mb-0">@(!string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : "Ingen beskrivelse endnu.")</p>
            </div>
        </div>

        <!-- Højre kolonne: book+cover -> faciliteter + plantegning -->
        <div class="col-lg-4">
            <a class="btn btn-dark btn-book mb-2"
               href="mailto:info@luksussommerhuse.dk?subject=Booking%20@Uri.EscapeDataString(Model.Title ?? " Sommerhus")">
                Book her!
            </a>
            <div class="side-cover mb-2">
                @if (!string.IsNullOrWhiteSpace(Model.CoverUrl))
                {
                    <img src="@Model.CoverUrl" alt="@Model.Title" />
                }
                else if (slides.Count > 0)
                {
                    <img src="@slides.First().Url" alt="@Model.Title" />
                }
                else
                {
                    <div class="card-lite text-muted">Intet coverbillede endnu.</div>
                }
            </div>

            <h5 class="mb-2">Faciliteter</h5>
            <div class="card-lite mb-3">
                <p class="mb-0">@(!string.IsNullOrWhiteSpace(Model.Facilities) ? Model.Facilities : "Ingen faciliteter angivet.")</p>
            </div>

            @if (Model.Floorplan is not null)
            {
                <h6 class="mb-2">Plantegning</h6>
                <div class="card-lite">
                    <img class="w-100" style="max-height:420px;object-fit:contain" src="@Model.Floorplan.Url" alt="Plantegning" />
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
