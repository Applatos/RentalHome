@using System.Globalization
@using System.Linq
@using Sommerhus.Core.Dtos.Shared
@using Sommerhus.Mvc.Infrastructure
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@model PublicHouseDetailsDto

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.City)
        ? Model.Title
        : $"{Model.City} – {Model.Title}";

    var images = (Model.Images ?? Array.Empty<ImageDto>()).ToList();

    // Adskil plantegninger
    var floorplans = images.Where(i => string.Equals(i.Kind, "floorplan", StringComparison.OrdinalIgnoreCase)).ToList();
    var galleryAll = images.Where(i => !string.Equals(i.Kind, "floorplan", StringComparison.OrdinalIgnoreCase)).ToList();

    // Cover (til højre kolonne)
    var cover = galleryAll.FirstOrDefault(i => string.Equals(i.Kind, "cover", StringComparison.OrdinalIgnoreCase))
               ?? galleryAll.FirstOrDefault();

    // Slides (venstre kolonne): alle galleri-billeder minus cover
    var slides = galleryAll;
    if (!slides.Any() && cover is not null)
    {
        // Fallback: hvis kun ét billede findes, brug det også i venstre, så der vises noget
        slides = new List<ImageDto> { cover };
    }

    // The price widget starts from the same stay and guest count as the booking form, and the
    // booking links carry it there; house-pricing.js keeps them in step with the selection.
    var today = BookingDefaults.Today;
    var defaultArrival = BookingDefaults.Arrival(today);
    var defaultDeparture = BookingDefaults.Departure(defaultArrival);
    var todayValue = BookingDefaults.FormatDate(today);
    var arrivalValue = BookingDefaults.FormatDate(defaultArrival);
    var departureValue = BookingDefaults.FormatDate(defaultDeparture);
    var maxGuests = BookingDefaults.MaxGuests(Model.MaxGuests);
    var defaultGuests = BookingDefaults.Guests(Model.MaxGuests);
    var bookPath = $"/houses/{Model.Id}/book";
    var bookUrl = BookingDefaults.BookUrl(Model.Id, defaultArrival, defaultDeparture, defaultGuests);
    var loginUrl = $"/account/login?returnUrl={Uri.EscapeDataString(bookUrl)}";
    var isSignedIn = User.Identity?.IsAuthenticated == true;

    var featureFacts = HouseFeatureFacts.From(Model.Features, CultureInfo.CurrentCulture);
}

<section class="container my-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">@Model.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Address) || !string.IsNullOrWhiteSpace(Model.Zip) || !string.IsNullOrWhiteSpace(Model.City))
            {
                <p class="text-body-secondary mb-0">
                    @Model.Address
                    @if (!string.IsNullOrWhiteSpace(Model.Address) && (!string.IsNullOrWhiteSpace(Model.Zip) || !string.IsNullOrWhiteSpace(Model.City)))
                    {
                        <span>, </span>
                    }
                    @Model.Zip @Model.City
                </p>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (isSignedIn)
            {
                @if (Model.IsFavorite == true)
                {
                    <form method="post" action="/account/favorites/@Model.Id/remove" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="/houses/@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm" title="@L["Pages.House.RemoveFavorite"]" aria-label="@L["Pages.House.RemoveFavorite"]">&#9829;</button>
                    </form>
                }
                else
                {
                    <form method="post" action="/account/favorites/@Model.Id/add" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="/houses/@Model.Id" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="@L["Pages.House.AddFavorite"]" aria-label="@L["Pages.House.AddFavorite"]">&#9825;</button>
                    </form>
                }
                <a class="btn btn-dark" href="@bookUrl" data-pricing-link="@bookPath">@L["Houses.Details.BookNow"]</a>
            }
            else
            {
                <a class="btn btn-outline-dark" href="@loginUrl" data-pricing-link="@bookPath" data-pricing-login="/account/login">@L["Houses.Details.LoginToBook"]</a>
            }
            <a class="btn btn-primary" href="#booking-card">@L["Houses.Details.CalculatePrice"]</a>
        </div>
    </div>

    <!-- TOP: 2 kolonner med billeder -->
    <div class="row g-3 mb-3">
        <!-- Venstre: Carousel uden thumbnails -->
        <div class="col-lg-8">
            @if (slides.Any())
            {
                <div id="houseCarousel" class="carousel slide" data-bs-ride="false">
                    <div class="carousel-inner rounded-3 overflow-hidden">
                        @for (var i = 0; i < slides.Count; i++)
                        {
                            var img = slides[i];
                            <div class="carousel-item @(i == 0 ? "active" : null)">
                                <div class="ratio ratio-16x9">
                                    <img src="@img.Url" alt="@img.Alt" class="d-block w-100" style="object-fit:cover;" loading="@(i == 0 ? "eager" : "lazy")" />
                                </div>
                            </div>
                        }
                    </div>

                    @if (slides.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#houseCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">@L["Pages.House.PreviousImage"]</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#houseCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">@L["Pages.House.NextImage"]</span>
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Højre: kun cover-billedet -->
        <div class="col-lg-4">
            @if (cover is not null)
            {
                <div class="ratio ratio-4x3 rounded-3 overflow-hidden">
                    <img src="@cover.Url" alt="@cover.Alt" class="w-100 h-100" style="object-fit:cover;" loading="lazy" />
                </div>
            }
        </div>
    </div>

    @* Key facts with their values. The row wraps, so the page is never wider than the screen. *@
    @if (featureFacts.Facts.Count > 0)
    {
        <ul class="list-unstyled d-flex flex-wrap gap-3 gap-md-4 border-top border-bottom py-3 my-3" aria-label="@L["Pages.House.KeyFacts"]">
            @foreach (var fact in featureFacts.Facts)
            {
                <li class="d-flex align-items-center gap-2">
                    @if (fact.IconUrl is not null)
                    {
                        <img src="@fact.IconUrl" alt="" width="28" height="28" loading="lazy" />
                    }
                    <span class="lh-sm">
                        <span class="d-block fw-semibold">@fact.Value</span>
                        <span class="d-block small text-body-secondary">@fact.Caption</span>
                    </span>
                </li>
            }
        </ul>
    }

    <!-- BUND: 2 kolonner igen -->
    <div class="row g-4">
        <div class="col-lg-7">
            <h2 class="h5">@L["Houses.Details.Description"]</h2>
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    @Html.Raw(Model.Description)   @* sanér server-side hvis HTML kommer udefra *@
                }
                else
                {
                    <p class="text-body-secondary">@L["Houses.Details.NoDescription"]</p>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div id="booking-card" class="card shadow-sm mb-4" data-pricing-root>
                <div class="card-body">
                    <h2 class="h5 mb-3">@L["Houses.Details.CalculatePrice"]</h2>
                    <form data-pricing-form
                          data-house-id="@Model.Id"
                          data-area-id=""
                          data-quote-url="@Url.Action("Quote", "Houses", new { id = Model.Id })">
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="arrival" class="form-label">@L["Houses.Details.Arrival"]</label>
                                <input type="date"
                                       class="form-control"
                                       id="arrival"
                                       name="arrival"
                                       value="@arrivalValue"
                                       min="@todayValue"
                                       data-pricing-arrival />
                            </div>
                            <div class="col-6">
                                <label for="departure" class="form-label">@L["Houses.Details.Departure"]</label>
                                <input type="date"
                                       class="form-control"
                                       id="departure"
                                       name="departure"
                                       value="@departureValue"
                                       min="@BookingDefaults.FormatDate(defaultArrival.AddDays(1))"
                                       data-pricing-departure />
                            </div>
                        </div>
                        <div class="mt-3">
                            <label for="guests" class="form-label">@L["Houses.Details.Guests"]</label>
                            <input type="number"
                                   class="form-control"
                                   id="guests"
                                   name="guests"
                                   min="1"
                                   max="@maxGuests"
                                   value="@defaultGuests"
                                   aria-describedby="@(Model.MaxGuests is > 0 ? "guests-hint" : null)"
                                   data-pricing-guests />
                            @if (Model.MaxGuests is > 0)
                            {
                                <div id="guests-hint" class="form-text">@L["Pages.House.GuestsHint", maxGuests]</div>
                            }
                        </div>
                    </form>
                    <partial name="~/Views/Houses/_PricingWidget.cshtml" model="Model.Id" />
                    <div class="d-grid mt-3">
                        @if (isSignedIn)
                        {
                            <a class="btn btn-dark" href="@bookUrl" data-pricing-link="@bookPath">@L["Houses.Details.BookNow"]</a>
                        }
                        else
                        {
                            <a class="btn btn-outline-dark" href="@loginUrl" data-pricing-link="@bookPath" data-pricing-login="/account/login">@L["Houses.Details.LoginToBook"]</a>
                        }
                    </div>
                </div>
            </div>

            @if (featureFacts.Facilities.Count > 0)
            {
                <h2 class="h5">@L["Houses.Details.Facilities"]</h2>
                <ul class="list-unstyled row row-cols-2 g-2 mb-3">
                    @foreach (var facility in featureFacts.Facilities)
                    {
                        <li class="col d-flex align-items-center gap-2">
                            @if (facility.IconUrl is not null)
                            {
                                <img src="@facility.IconUrl" alt="" width="20" height="20" loading="lazy" />
                            }
                            <span class="small">@facility.Name</span>
                        </li>
                    }
                </ul>
            }

            @if (floorplans.Any())
            {
                <h3 class="h6">@L["Houses.Details.Floorplan"]</h3>
                <div class="row g-2">
                    @foreach (var fp in floorplans)
                    {
                        <div class="col-12">
                            <div class="ratio ratio-4x3 bg-white rounded-3">
                                <img src="@fp.Url" alt="@fp.Alt" class="w-100 h-100" style="object-fit:contain;" loading="lazy" />
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/house-pricing.js" asp-append-version="true"></script>
}
