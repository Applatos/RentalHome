@using System.Globalization
@using System.Text.Json
@using Sommerhus.Core.Dtos.Shared
@using Sommerhus.Mvc.Infrastructure
@inject Microsoft.Extensions.Localization.IStringLocalizer<Sommerhus.Mvc.SharedResource> L
@model PublicHouseListItemDto
@{
    var culture = CultureInfo.CurrentCulture;
    var href = $"/houses/{Model.Id}";
    var area = Model.Areas?.FirstOrDefault() ?? Model.City;

    // The cover first, then the gallery: the card's images in display order.
    var images = new List<(string Url, string Alt)>();
    if (!string.IsNullOrWhiteSpace(Model.CoverUrl))
    {
        images.Add((Model.CoverUrl, Model.Title));
    }
    foreach (var image in Model.Gallery ?? [])
    {
        images.Add((image.Url, string.IsNullOrWhiteSpace(image.Alt) ? Model.Title : image.Alt));
    }

    var sources = JsonSerializer.Serialize(images.Select(i => new { src = i.Url, alt = i.Alt }));
    var facts = HouseCardFacts.FactsLine(Model.Features, L, culture);
    var icons = HouseCardFacts.Icons(Model.Features, culture);
}

<article class="house-card" data-carousel data-carousel-images="@sources">
    <div class="house-card__media">
        <a href="@href" tabindex="-1" aria-hidden="true">
            @if (images.Count > 0)
            {
                <img src="@images[0].Url" alt="@images[0].Alt" data-carousel-image loading="lazy" decoding="async" />
            }
        </a>
        @if (!string.IsNullOrWhiteSpace(area))
        {
            <span class="media-chip media-chip--area">@area</span>
        }
        @if (images.Count > 1)
        {
            <button type="button" class="media-arrow media-arrow--prev" data-carousel-prev aria-label="@L["Pages.Gallery.Previous"]"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
            <button type="button" class="media-arrow media-arrow--next" data-carousel-next aria-label="@L["Pages.Gallery.Next"]"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            <span class="media-chip media-chip--counter" data-carousel-counter>1 / @images.Count</span>
        }
    </div>

    @if (images.Count > 1)
    {
        <ul class="house-card__thumbs">
            @for (var i = 0; i < images.Count; i++)
            {
                <li>
                    <button type="button" class="house-card__thumb" data-carousel-thumb="@i" aria-pressed="@(i == 0 ? "true" : "false")" aria-label="@L["Pages.Gallery.Show", i + 1]">
                        <img src="@images[i].Url" alt="" loading="lazy" decoding="async" />
                    </button>
                </li>
            }
        </ul>
    }

    <div class="house-card__body">
        <div>
            <h2 class="house-card__title"><a href="@href">@Model.Title</a></h2>
            @if (facts is not null)
            {
                <p class="house-card__facts">@facts</p>
            }
        </div>

        @if (icons.Count > 0)
        {
            <ul class="house-card__icons">
                @foreach (var icon in icons)
                {
                    <li><img src="@icon.IconUrl" alt="" width="26" height="26" />@icon.Label</li>
                }
            </ul>
        }

        <div class="house-card__footer">
            @if (Model.MinNightlyPrice.HasValue)
            {
                <p class="price-from">@L["Pages.HouseCard.From"] <strong>@MoneyText.Format(Model.MinNightlyPrice.Value, Model.Currency, culture)</strong> / @L["Pages.HouseCard.Night"]</p>
            }
            else
            {
                <span></span>
            }
            <a class="btn btn-primary" href="@href">@L["Pages.HouseCard.SeeHouse"]</a>
        </div>
    </div>
</article>
