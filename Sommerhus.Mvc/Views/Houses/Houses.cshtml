@using Sommerhus.Mvc.ViewModels.Public.Houses
@model HouseListVm
@{
    ViewData["Title"] = "Luksus Sommerhuse i Danmark";
}
<section class="container">
    <header class="my-4 text-center">
        <h2>Sommerhusudlejning - Enkelt og sikkert</h2>
        <p>Find det helt rigtige sommerhus. Filtrér på område/by og søg i titler/beskrivelser.</p>
    </header>

    @await Html.PartialAsync("~/Views/Shared/_FlashMessages.cshtml")

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <input name="q" value="@Model.Query" class="form-control" placeholder="Søg..." />
        </div>
        <div class="col-md-4">
            <select name="area" class="form-select">
                <option value="">Alle områder</option>
                @foreach (var a in Model.Areas.OrderBy(a => a.Name))
                {
                    <option value="@a.Id" selected="@(a.Id.ToString() == Model.SelectedArea)">@a.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-dark w-100">Søg</button></div>
        <div class="col-md-2"><a class="btn btn-outline-secondary w-100" href="/">Nulstil</a></div>
    </form>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        @if (Model.Houses.Count > 0)
        {
            @foreach (var house in Model.Houses)
            {
                <div class="col">
                    @await Html.PartialAsync("~/Views/Houses/_HouseCard.cshtml", house)
                </div>
            }
        }
        else
        {
            <div class="col">
                <p>Ingen sommerhuse fundet.</p>
            </div>
        }
    </div>
</section>
